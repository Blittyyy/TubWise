---
/**
 * Client-side hot tub fill-time estimator.
 * No storage, cookies, analytics, or network submission of measurements.
 */
---

<div
  class="not-prose rounded-2xl border border-border bg-surface-raised p-5 shadow-[0_1px_2px_rgba(26,43,60,0.04)] sm:p-7"
  data-fill-time-calculator
>
  <form data-fill-time-form class="space-y-6" novalidate>
    <div>
      <label for="fill-capacity" class="block text-sm font-medium text-ink">Spa capacity</label>
      <div class="mt-2 grid gap-3 sm:grid-cols-[minmax(0,1fr)_11rem]">
        <input
          id="fill-capacity"
          name="capacity"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="e.g. 400"
          aria-describedby="fill-capacity-hint fill-capacity-error"
          data-field="capacity"
          class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        />
        <select
          id="fill-capacity-unit"
          name="capacityUnit"
          data-capacity-unit
          aria-label="Capacity unit"
          class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          <option value="gal" selected>U.S. gallons</option>
          <option value="L">Liters</option>
        </select>
      </div>
      <p id="fill-capacity-hint" class="mt-1.5 text-sm text-ink-subtle">
        Not sure of the capacity? Estimate it with the
        <a href="/calculators/hot-tub-volume-calculator" class="font-medium text-brand-dark underline-offset-2 hover:underline"
          >Hot Tub Volume Calculator</a
        >.
      </p>
      <p
        id="fill-capacity-error"
        class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
        data-error-for="capacity"
        role="alert"
      ></p>
    </div>

    <fieldset>
      <legend class="font-display text-lg font-semibold text-ink">Current fill level</legend>
      <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Current fill level">
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="fillPreset"
            value="empty"
            checked
            class="h-4 w-4 accent-brand"
            data-fill-preset
          />
          <span class="text-base font-medium text-ink">Empty</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input type="radio" name="fillPreset" value="25" class="h-4 w-4 accent-brand" data-fill-preset />
          <span class="text-base font-medium text-ink">25% full</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input type="radio" name="fillPreset" value="50" class="h-4 w-4 accent-brand" data-fill-preset />
          <span class="text-base font-medium text-ink">50% full</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input type="radio" name="fillPreset" value="75" class="h-4 w-4 accent-brand" data-fill-preset />
          <span class="text-base font-medium text-ink">75% full</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft sm:col-span-2"
        >
          <input type="radio" name="fillPreset" value="custom" class="h-4 w-4 accent-brand" data-fill-preset />
          <span class="text-base font-medium text-ink">Custom percentage</span>
        </label>
      </div>

      <div class="mt-3 hidden" data-custom-percent-wrap>
        <label for="fill-custom-percent" class="block text-sm font-medium text-ink"
          >Custom fill percentage</label
        >
        <input
          id="fill-custom-percent"
          name="customPercent"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="e.g. 40"
          aria-describedby="fill-custom-percent-hint fill-percent-error"
          data-field="fillPercent"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        />
        <p id="fill-custom-percent-hint" class="mt-1.5 text-sm text-ink-subtle">
          Enter a value from 0 through 99. 100% is not allowed because no fill time would remain.
        </p>
        <p
          id="fill-percent-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="fillPercent"
          role="alert"
        ></p>
      </div>
    </fieldset>

    <fieldset>
      <legend class="font-display text-lg font-semibold text-ink">Hose flow rate</legend>
      <p class="mt-2 text-sm text-ink-subtle">
        Hose flow varies by faucet setting, hose size, and attachments. Measure your own setup
        rather than assuming a universal garden-hose rate.
      </p>
      <div class="mt-3 grid grid-cols-1 gap-2" role="radiogroup" aria-label="Hose flow input mode">
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="flowInputMode"
            value="known"
            checked
            class="h-4 w-4 accent-brand"
            data-flow-mode
          />
          <span class="text-base font-medium text-ink">I know my hose flow rate</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="flowInputMode"
            value="measure"
            class="h-4 w-4 accent-brand"
            data-flow-mode
          />
          <span class="text-base font-medium text-ink">Measure my hose flow with a bucket</span>
        </label>
      </div>

      <div class="mt-4" data-known-flow-wrap>
        <label for="fill-flow" class="block text-sm font-medium text-ink">Hose flow rate</label>
        <div class="mt-2 grid gap-3 sm:grid-cols-[minmax(0,1fr)_13rem]">
          <input
            id="fill-flow"
            name="flowRate"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 5"
            aria-describedby="fill-flow-hint fill-flow-error"
            data-field="flowRate"
            class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
          <select
            id="fill-flow-unit"
            name="flowUnit"
            data-flow-unit
            aria-label="Flow rate unit"
            class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <option value="gpm" selected>Gallons per minute</option>
            <option value="lpm">Liters per minute</option>
          </select>
        </div>
        <p id="fill-flow-hint" class="mt-1.5 text-sm text-ink-subtle">
          Enter the flow rate for the same hose, faucet opening, and attachments you will use to
          fill the spa.
        </p>
        <p
          id="fill-flow-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="flowRate"
          role="alert"
        ></p>
      </div>

      <div class="mt-4 hidden" data-measure-flow-wrap>
        <p id="fill-bucket-instructions" class="text-sm leading-relaxed text-ink-muted">
          Use a bucket of known volume. Open the faucet to the setting you will use for filling,
          keep the same hose and any nozzle or pre-filter attached, and time how many seconds the
          bucket takes to fill. Do not assume a second hose will double the flow.
        </p>

        <div class="mt-4">
          <label for="fill-bucket-unit" class="block text-sm font-medium text-ink">Bucket unit</label>
          <select
            id="fill-bucket-unit"
            name="bucketUnit"
            data-bucket-unit
            aria-describedby="fill-bucket-instructions"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
          >
            <option value="gal" selected>U.S. gallons</option>
            <option value="L">Liters</option>
          </select>
        </div>

        <fieldset class="mt-4">
          <legend class="block text-sm font-medium text-ink">Bucket capacity</legend>
          <div
            class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3"
            role="radiogroup"
            aria-label="Bucket capacity"
            data-bucket-preset-group
          >
            <!-- Options populated/synced by script for gallon vs liter presets -->
          </div>
          <p
            id="fill-bucket-capacity-error"
            class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
            data-error-for="bucketCapacity"
            role="alert"
          ></p>
        </fieldset>

        <div class="mt-3 hidden" data-custom-bucket-wrap>
          <label for="fill-custom-bucket" class="block text-sm font-medium text-ink"
            >Custom bucket capacity</label
          >
          <input
            id="fill-custom-bucket"
            name="customBucketCapacity"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 4"
            aria-describedby="fill-custom-bucket-hint fill-bucket-capacity-error"
            data-field="bucketCapacity"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
          />
          <p id="fill-custom-bucket-hint" class="mt-1.5 text-sm text-ink-subtle">
            Enter the marked capacity of the bucket you are timing.
          </p>
        </div>

        <div class="mt-4">
          <label for="fill-bucket-seconds" class="block text-sm font-medium text-ink"
            >Seconds to fill the bucket</label
          >
          <input
            id="fill-bucket-seconds"
            name="bucketSeconds"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 60"
            aria-describedby="fill-bucket-seconds-hint fill-bucket-seconds-error"
            data-field="bucketSeconds"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
          />
          <p id="fill-bucket-seconds-hint" class="mt-1.5 text-sm text-ink-subtle">
            Flow per minute = bucket capacity × 60 ÷ seconds.
          </p>
          <p
            id="fill-bucket-seconds-error"
            class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
            data-error-for="bucketSeconds"
            role="alert"
          ></p>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend class="font-display text-lg font-semibold text-ink">Start time (optional)</legend>
      <p class="mt-2 text-sm text-ink-subtle">
        Add a start time only if you want an estimated completion time. This stays on your device.
        Treat it as a planning estimate, not an unattended filling timer.
      </p>
      <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3" role="radiogroup" aria-label="Start time option">
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="startMode"
            value="none"
            checked
            class="h-4 w-4 accent-brand"
            data-start-mode
          />
          <span class="text-base font-medium text-ink">No start time</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input type="radio" name="startMode" value="now" class="h-4 w-4 accent-brand" data-start-mode />
          <span class="text-base font-medium text-ink">Use current time</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="startMode"
            value="custom"
            class="h-4 w-4 accent-brand"
            data-start-mode
          />
          <span class="text-base font-medium text-ink">Custom time</span>
        </label>
      </div>

      <div class="mt-3 hidden" data-custom-time-wrap>
        <label for="fill-start-time" class="block text-sm font-medium text-ink">Custom start time</label>
        <input
          id="fill-start-time"
          name="startTime"
          type="time"
          autocomplete="off"
          aria-describedby="fill-start-time-hint fill-start-time-error"
          data-field="startTime"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        />
        <p id="fill-start-time-hint" class="mt-1.5 text-sm text-ink-subtle">
          Uses today’s date on this device. No timezone or location is collected.
        </p>
        <p
          id="fill-start-time-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="startTime"
          role="alert"
        ></p>
      </div>
    </fieldset>

    <fieldset class="rounded-xl border border-border/80 bg-surface/60 p-4 sm:p-5">
      <legend class="px-1 font-display text-base font-semibold text-ink">
        Water cost estimate (optional)
      </legend>
      <p class="mt-1 text-sm text-ink-subtle">
        Optional. Uses remaining water volume only. Leave blank to skip the cost estimate.
      </p>
      <div class="mt-3 grid gap-3 sm:grid-cols-[minmax(0,1fr)_14rem]">
        <div>
          <label for="fill-water-rate" class="block text-sm font-medium text-ink"
            >Local water utility rate</label
          >
          <input
            id="fill-water-rate"
            name="waterRate"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 5.00"
            aria-describedby="fill-water-rate-hint fill-water-rate-error"
            data-field="waterRate"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
        </div>
        <div>
          <label for="fill-water-rate-unit" class="block text-sm font-medium text-ink">Rate unit</label>
          <select
            id="fill-water-rate-unit"
            name="waterRateUnit"
            data-water-rate-unit
            aria-label="Water rate unit"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <option value="per_1000_gal" selected>Dollars per 1,000 gallons</option>
            <option value="per_gal">Dollars per gallon</option>
            <option value="per_1000_L">Dollars per 1,000 liters</option>
            <option value="per_L">Dollars per liter</option>
          </select>
        </div>
      </div>
      <p id="fill-water-rate-hint" class="mt-1.5 text-sm text-ink-subtle">
        Use the volumetric water charge from your bill. Do not assume a universal municipal rate.
        The estimate excludes heating, sewer charges, fixed fees, tier changes, and other utility
        charges.
      </p>
      <p
        id="fill-water-rate-error"
        class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
        data-error-for="waterRate"
        role="alert"
      ></p>
    </fieldset>

    <div class="flex flex-col gap-3 sm:flex-row">
      <button
        type="submit"
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand px-5 text-base font-medium text-white transition-colors hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Estimate fill time
      </button>
      <button
        type="button"
        data-reset
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-border bg-surface px-5 text-base font-medium text-ink transition-colors hover:border-brand/40 hover:bg-brand-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Reset
      </button>
    </div>
  </form>

  <div
    class="mt-6 hidden rounded-2xl border border-brand/25 bg-brand-soft p-5 sm:p-6"
    data-result
    aria-live="polite"
    aria-atomic="true"
  ></div>
</div>

<script>
  import {
    addMinutes,
    BUCKET_PRESETS_GAL,
    BUCKET_PRESETS_L,
    calculateFillTime,
    CAPACITY_UNIT_LABELS,
    FLOW_UNIT_LABELS,
    formatLocalDateTime,
    formatWholeNumber,
    parseLocalTimeInput,
    WATER_RATE_UNIT_LABELS,
    type BucketPreset,
    type CapacityUnit,
    type FillPreset,
    type FillTimeFieldKey,
    type FillTimeResult,
    type FlowInputMode,
    type FlowUnit,
    type WaterRateUnit,
  } from '../utils/hot-tub-fill-time';

  type StartMode = 'none' | 'now' | 'custom';

  function initCalculator(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-fill-time-form]');
    const resultEl = root.querySelector<HTMLElement>('[data-result]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
    const capacityUnit = root.querySelector<HTMLSelectElement>('[data-capacity-unit]');
    const flowUnit = root.querySelector<HTMLSelectElement>('[data-flow-unit]');
    const bucketUnit = root.querySelector<HTMLSelectElement>('[data-bucket-unit]');
    const waterRateUnit = root.querySelector<HTMLSelectElement>('[data-water-rate-unit]');
    const customPercentWrap = root.querySelector<HTMLElement>('[data-custom-percent-wrap]');
    const customTimeWrap = root.querySelector<HTMLElement>('[data-custom-time-wrap]');
    const knownFlowWrap = root.querySelector<HTMLElement>('[data-known-flow-wrap]');
    const measureFlowWrap = root.querySelector<HTMLElement>('[data-measure-flow-wrap]');
    const customBucketWrap = root.querySelector<HTMLElement>('[data-custom-bucket-wrap]');
    const bucketPresetGroup = root.querySelector<HTMLElement>('[data-bucket-preset-group]');
    const fillPresetInputs = root.querySelectorAll<HTMLInputElement>('[data-fill-preset]');
    const startModeInputs = root.querySelectorAll<HTMLInputElement>('[data-start-mode]');
    const flowModeInputs = root.querySelectorAll<HTMLInputElement>('[data-flow-mode]');

    if (
      !form ||
      !resultEl ||
      !resetBtn ||
      !capacityUnit ||
      !flowUnit ||
      !bucketUnit ||
      !waterRateUnit ||
      !customPercentWrap ||
      !customTimeWrap ||
      !knownFlowWrap ||
      !measureFlowWrap ||
      !customBucketWrap ||
      !bucketPresetGroup
    ) {
      return;
    }

    const fieldOrder: FillTimeFieldKey[] = [
      'capacity',
      'fillPercent',
      'flowRate',
      'bucketCapacity',
      'bucketSeconds',
      'waterRate',
      'startTime',
    ];

    function currentFillPreset(): FillPreset {
      const checked = form!.querySelector<HTMLInputElement>('input[name="fillPreset"]:checked');
      const value = checked?.value;
      if (value === '25' || value === '50' || value === '75' || value === 'custom') return value;
      return 'empty';
    }

    function currentStartMode(): StartMode {
      const checked = form!.querySelector<HTMLInputElement>('input[name="startMode"]:checked');
      const value = checked?.value;
      if (value === 'now' || value === 'custom') return value;
      return 'none';
    }

    function currentFlowMode(): FlowInputMode {
      const checked = form!.querySelector<HTMLInputElement>('input[name="flowInputMode"]:checked');
      return checked?.value === 'measure' ? 'measure' : 'known';
    }

    function currentBucketPreset(): BucketPreset {
      const checked = form!.querySelector<HTMLInputElement>('input[name="bucketPreset"]:checked');
      const value = checked?.value;
      if (
        value === '1' ||
        value === '2' ||
        value === '5' ||
        value === '10' ||
        value === '15' ||
        value === '20' ||
        value === 'custom'
      ) {
        return value;
      }
      return bucketUnit!.value === 'L' ? '10' : '5';
    }

    function syncFillPreset() {
      const isCustom = currentFillPreset() === 'custom';
      customPercentWrap!.hidden = !isCustom;
      customPercentWrap!.classList.toggle('hidden', !isCustom);
      const customInput = form!.querySelector<HTMLInputElement>('[data-field="fillPercent"]');
      if (customInput) customInput.disabled = !isCustom;
    }

    function syncStartMode() {
      const isCustom = currentStartMode() === 'custom';
      customTimeWrap!.hidden = !isCustom;
      customTimeWrap!.classList.toggle('hidden', !isCustom);
      const timeInput = form!.querySelector<HTMLInputElement>('[data-field="startTime"]');
      if (timeInput) timeInput.disabled = !isCustom;
    }

    function syncBucketCustom() {
      const isCustom = currentBucketPreset() === 'custom';
      customBucketWrap!.hidden = !isCustom;
      customBucketWrap!.classList.toggle('hidden', !isCustom);
      const customInput = form!.querySelector<HTMLInputElement>('[data-field="bucketCapacity"]');
      if (customInput) customInput.disabled = !isCustom || currentFlowMode() !== 'measure';
    }

    function renderBucketPresets(preferred?: BucketPreset) {
      const unit = bucketUnit!.value as CapacityUnit;
      const presets = unit === 'L' ? BUCKET_PRESETS_L : BUCKET_PRESETS_GAL;
      const unitLabel = unit === 'L' ? 'L' : 'gal';
      const preferredValue =
        preferred && preferred !== 'custom' && (presets as string[]).includes(preferred)
          ? preferred
          : presets.includes('5')
            ? '5'
            : presets[0];

      bucketPresetGroup!.innerHTML = '';
      for (const preset of presets) {
        const label = document.createElement('label');
        label.className =
          'flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft';
        label.innerHTML = `
          <input
            type="radio"
            name="bucketPreset"
            value="${preset}"
            class="h-4 w-4 accent-brand"
            data-bucket-preset
            ${preset === preferredValue ? 'checked' : ''}
          />
          <span class="text-base font-medium text-ink">${preset} ${unitLabel}</span>
        `;
        bucketPresetGroup!.appendChild(label);
      }

      const customLabel = document.createElement('label');
      customLabel.className =
        'flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft sm:col-span-1';
      customLabel.innerHTML = `
        <input
          type="radio"
          name="bucketPreset"
          value="custom"
          class="h-4 w-4 accent-brand"
          data-bucket-preset
          ${preferred === 'custom' ? 'checked' : ''}
        />
        <span class="text-base font-medium text-ink">Custom</span>
      `;
      bucketPresetGroup!.appendChild(customLabel);

      bucketPresetGroup!.querySelectorAll<HTMLInputElement>('[data-bucket-preset]').forEach((input) => {
        input.addEventListener('change', () => {
          clearErrors();
          clearResult();
          syncBucketCustom();
        });
      });

      syncBucketCustom();
    }

    function syncFlowMode() {
      const mode = currentFlowMode();
      const isKnown = mode === 'known';
      knownFlowWrap!.hidden = !isKnown;
      knownFlowWrap!.classList.toggle('hidden', !isKnown);
      measureFlowWrap!.hidden = isKnown;
      measureFlowWrap!.classList.toggle('hidden', isKnown);

      const flowInput = form!.querySelector<HTMLInputElement>('[data-field="flowRate"]');
      if (flowInput) flowInput.disabled = !isKnown;
      flowUnit!.disabled = !isKnown;

      const secondsInput = form!.querySelector<HTMLInputElement>('[data-field="bucketSeconds"]');
      if (secondsInput) secondsInput.disabled = isKnown;
      bucketUnit!.disabled = isKnown;

      bucketPresetGroup!.querySelectorAll<HTMLInputElement>('[data-bucket-preset]').forEach((input) => {
        input.disabled = isKnown;
      });
      syncBucketCustom();
    }

    function clearErrors() {
      for (const field of fieldOrder) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
        const error = form!.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (input) {
          input.removeAttribute('aria-invalid');
          input.classList.remove('border-[#c45c4a]');
        }
        if (error) {
          error.textContent = '';
          error.classList.add('hidden');
        }
      }
    }

    function showErrors(errors: { field: FillTimeFieldKey; message: string }[]) {
      clearErrors();
      for (const error of errors) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${error.field}"]`);
        const errorEl = form!.querySelector<HTMLElement>(`[data-error-for="${error.field}"]`);
        if (input && !input.disabled) {
          input.setAttribute('aria-invalid', 'true');
          input.classList.add('border-[#c45c4a]');
        }
        if (errorEl) {
          errorEl.textContent = error.message;
          errorEl.classList.remove('hidden');
          const percentWrap = errorEl.closest<HTMLElement>('[data-custom-percent-wrap]');
          if (percentWrap) {
            percentWrap.hidden = false;
            percentWrap.classList.remove('hidden');
          }
          const bucketWrap = errorEl.closest<HTMLElement>('[data-custom-bucket-wrap]');
          if (bucketWrap) {
            bucketWrap.hidden = false;
            bucketWrap.classList.remove('hidden');
          }
        }
      }

      const first = errors[0];
      if (!first) return;
      const firstInput = form!.querySelector<HTMLInputElement>(`[data-field="${first.field}"]`);
      if (firstInput && !firstInput.disabled) {
        firstInput.focus();
        return;
      }
      if (first.field === 'fillPercent') {
        form!.querySelector<HTMLInputElement>('input[name="fillPreset"][value="custom"]')?.focus();
        return;
      }
      if (first.field === 'bucketCapacity') {
        form!.querySelector<HTMLInputElement>('input[name="bucketPreset"][value="custom"]')?.focus();
      }
    }

    function clearResult() {
      resultEl!.hidden = true;
      resultEl!.classList.add('hidden');
      resultEl!.innerHTML = '';
    }

    function escapeHtml(value: string): string {
      return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function resolveStartTime():
      | { ok: true; start: Date | null; label: string | null }
      | { ok: false; message: string } {
      const mode = currentStartMode();
      if (mode === 'none') return { ok: true, start: null, label: null };
      if (mode === 'now') {
        const start = new Date();
        return { ok: true, start, label: `Current time (${formatLocalDateTime(start)})` };
      }
      const raw = form!.querySelector<HTMLInputElement>('[data-field="startTime"]')?.value ?? '';
      const parsed = parseLocalTimeInput(raw);
      if (!parsed) {
        return {
          ok: false,
          message: raw.trim() ? 'Enter a valid start time.' : 'Enter a custom start time.',
        };
      }
      return { ok: true, start: parsed, label: formatLocalDateTime(parsed) };
    }

    function renderResult(data: FillTimeResult, startLabel: string | null, finishLabel: string | null) {
      const capacityLabel = CAPACITY_UNIT_LABELS[data.capacityUnit];
      const flowLabel = FLOW_UNIT_LABELS[data.flowUnit];
      const completionBlock =
        finishLabel && startLabel
          ? `<p class="mt-4 text-xl font-semibold text-ink sm:text-2xl">
              Estimated completion: ${escapeHtml(finishLabel)}
            </p>
            <p class="mt-1 text-sm text-ink-muted">Based on start time ${escapeHtml(startLabel)}. This is a planning estimate, not an unattended filling timer.</p>`
          : `<p class="mt-4 text-sm text-ink-muted">
              No start time was entered, so a completion clock time is not shown.
            </p>`;

      const measuredBlock = data.measuredFromBucket
        ? `<p class="mt-4 rounded-xl border border-border bg-surface px-4 py-3 text-base text-ink">
            <span class="font-medium">Measured hose flow:</span>
            ${escapeHtml(data.inputsSummary.flowRate)} ${escapeHtml(flowLabel.toLowerCase())}
          </p>`
        : '';

      const costBlock = data.waterCost.available
        ? `<div class="mt-5 border-t border-brand/20 pt-4">
            <p class="text-sm font-medium uppercase tracking-wide text-ink-muted">Optional water cost</p>
            <p class="mt-2 text-lg font-semibold text-ink">
              About ${escapeHtml(data.waterCost.displayCostUsd ?? '')} for the remaining water
            </p>
            <p class="mt-1 text-sm text-ink-muted">
              Based on ${formatWholeNumber(data.displayRemainingGallons)} gallons remaining at
              ${escapeHtml(data.waterCost.rateEntered ?? '')}
              (${escapeHtml(
                data.waterCost.rateUnit
                  ? WATER_RATE_UNIT_LABELS[data.waterCost.rateUnit].toLowerCase()
                  : '',
              )}).
              Excludes heating, sewer charges, fixed fees, tier changes, and other utility charges.
            </p>
          </div>`
        : `<p class="mt-5 border-t border-brand/20 pt-4 text-sm text-ink-muted">
            Water cost estimate unavailable — no local water rate was entered.
          </p>`;

      resultEl!.innerHTML = `
        <h2 class="font-display text-xl font-semibold text-ink">Fill time estimate</h2>
        <p class="mt-4 text-2xl font-semibold text-ink sm:text-3xl">
          About ${formatWholeNumber(data.displayRemainingGallons)} gallons remaining
        </p>
        <p class="mt-1 text-xl font-semibold text-ink sm:text-2xl">
          About ${formatWholeNumber(data.displayRemainingLiters)} liters remaining
        </p>
        <p class="mt-4 text-2xl font-semibold text-ink sm:text-3xl">
          About ${escapeHtml(data.durationLabel)}
        </p>
        <p class="mt-1 text-sm text-ink-muted">
          (${formatWholeNumber(data.displayTotalMinutes)} minutes total)
        </p>
        ${measuredBlock}
        ${completionBlock}
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          This estimate assumes a steady hose flow at the rate used above. Pressure and flow
          can change while you fill, so treat the clock time as guidance, not a guarantee.
        </p>
        <div class="mt-5 rounded-xl border border-warning-border bg-warning-bg p-4 text-sm leading-relaxed text-warning-ink" role="note">
          <p>
            <strong class="font-semibold">Estimate warning:</strong>
            This is an estimate. Actual fill time can change if water pressure or hose flow
            varies during filling.
          </p>
          <p class="mt-3">
            Do not leave a filling hot tub unattended. Follow the manufacturer’s filling
            instructions, including any required filter-compartment or standpipe filling method.
            Confirm the required fill method, fill to the specified waterline, and do not
            energize the spa until the owner’s manual permits it.
          </p>
        </div>
        ${costBlock}
        <dl class="mt-5 space-y-2 text-sm text-ink-muted">
          <div>
            <dt class="inline font-medium text-ink">Capacity entered:</dt>
            <dd class="inline">
              ${escapeHtml(data.inputsSummary.capacity)} ${escapeHtml(capacityLabel.toLowerCase())}
            </dd>
          </div>
          <div>
            <dt class="inline font-medium text-ink">Current fill level:</dt>
            <dd class="inline">${escapeHtml(data.inputsSummary.fillLabel)}</dd>
          </div>
          <div>
            <dt class="inline font-medium text-ink">Hose flow rate:</dt>
            <dd class="inline">
              ${escapeHtml(data.inputsSummary.flowRate)} ${escapeHtml(flowLabel.toLowerCase())}
            </dd>
          </div>
          <div>
            <dt class="inline font-medium text-ink">Flow source:</dt>
            <dd class="inline">${escapeHtml(data.inputsSummary.flowSourceLabel)}</dd>
          </div>
        </dl>
      `;
      resultEl!.hidden = false;
      resultEl!.classList.remove('hidden');
    }

    fillPresetInputs.forEach((input) => {
      input.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncFillPreset();
      });
    });

    startModeInputs.forEach((input) => {
      input.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncStartMode();
      });
    });

    flowModeInputs.forEach((input) => {
      input.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncFlowMode();
      });
    });

    bucketUnit.addEventListener('change', () => {
      clearErrors();
      clearResult();
      renderBucketPresets();
      syncFlowMode();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const outcome = calculateFillTime({
        capacity: form.querySelector<HTMLInputElement>('[data-field="capacity"]')?.value ?? '',
        capacityUnit: capacityUnit.value as CapacityUnit,
        fillPreset: currentFillPreset(),
        customPercent: form.querySelector<HTMLInputElement>('[data-field="fillPercent"]')?.value ?? '',
        flowInputMode: currentFlowMode(),
        flowRate: form.querySelector<HTMLInputElement>('[data-field="flowRate"]')?.value ?? '',
        flowUnit: flowUnit.value as FlowUnit,
        bucketPreset: currentBucketPreset(),
        customBucketCapacity:
          form.querySelector<HTMLInputElement>('[data-field="bucketCapacity"]')?.value ?? '',
        bucketUnit: bucketUnit.value as CapacityUnit,
        bucketSeconds: form.querySelector<HTMLInputElement>('[data-field="bucketSeconds"]')?.value ?? '',
        waterRate: form.querySelector<HTMLInputElement>('[data-field="waterRate"]')?.value ?? '',
        waterRateUnit: waterRateUnit.value as WaterRateUnit,
      });

      if (!outcome.ok) {
        clearResult();
        showErrors(outcome.errors);
        return;
      }

      const startOutcome = resolveStartTime();
      if (!startOutcome.ok) {
        clearResult();
        showErrors([{ field: 'startTime', message: startOutcome.message }]);
        return;
      }

      clearErrors();
      let finishLabel: string | null = null;
      if (startOutcome.start) {
        const finish = addMinutes(startOutcome.start, outcome.result.durationMinutesExact);
        finishLabel = formatLocalDateTime(finish);
      }
      renderResult(outcome.result, startOutcome.label, finishLabel);
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      const empty = form.querySelector<HTMLInputElement>('input[name="fillPreset"][value="empty"]');
      const none = form.querySelector<HTMLInputElement>('input[name="startMode"][value="none"]');
      const known = form.querySelector<HTMLInputElement>('input[name="flowInputMode"][value="known"]');
      if (empty) empty.checked = true;
      if (none) none.checked = true;
      if (known) known.checked = true;
      capacityUnit.value = 'gal';
      flowUnit.value = 'gpm';
      bucketUnit.value = 'gal';
      waterRateUnit.value = 'per_1000_gal';
      clearErrors();
      clearResult();
      renderBucketPresets('5');
      syncFillPreset();
      syncStartMode();
      syncFlowMode();
      form.querySelector<HTMLInputElement>('[data-field="capacity"]')?.focus();
    });

    renderBucketPresets('5');
    syncFillPreset();
    syncStartMode();
    syncFlowMode();
  }

  document.querySelectorAll<HTMLElement>('[data-fill-time-calculator]').forEach(initCalculator);
</script>
