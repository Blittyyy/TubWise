---
/**
 * Client-side hot tub heat-up time estimator.
 * No storage, cookies, analytics, or network submission of measurements.
 */
import {
  HEATER_PRESET_VALUES,
  HEAT_LOSS_PRESET_LABELS,
} from '../utils/hot-tub-heat-up-time';

const heaterPresets = HEATER_PRESET_VALUES;
const heatLossPresets = ['none', '10', '20', '30', 'custom'] as const;
---

<div
  class="not-prose rounded-2xl border border-border bg-surface-raised p-5 shadow-[0_1px_2px_rgba(26,43,60,0.04)] sm:p-7"
  data-heat-up-calculator
>
  <form data-heat-up-form class="space-y-6" novalidate>
    <fieldset>
      <legend class="font-display text-lg font-semibold text-ink">Calculation mode</legend>
      <div class="mt-3 grid grid-cols-1 gap-2" role="radiogroup" aria-label="Calculation mode">
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="heatUpMode"
            value="heater"
            checked
            class="h-4 w-4 accent-brand"
            data-heat-mode
          />
          <span class="text-base font-medium text-ink">Heater power</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="heatUpMode"
            value="measured"
            class="h-4 w-4 accent-brand"
            data-heat-mode
          />
          <span class="text-base font-medium text-ink">Measured heating rate</span>
        </label>
      </div>
      <p class="mt-2 text-sm text-ink-subtle">
        Use heater power when you know the spa&apos;s documented heater rating. Use measured rate when
        the spa is already warming and you can time the temperature climb.
      </p>
    </fieldset>

    <div data-shared-temps>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="heat-current-temp" class="block text-sm font-medium text-ink"
            >Current water temperature</label
          >
          <input
            id="heat-current-temp"
            name="currentTemp"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 60"
            aria-describedby="heat-current-temp-error"
            data-field="currentTemp"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
          <p
            id="heat-current-temp-error"
            class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
            data-error-for="currentTemp"
            role="alert"
          ></p>
        </div>
        <div>
          <label for="heat-target-temp" class="block text-sm font-medium text-ink"
            >Target water temperature</label
          >
          <input
            id="heat-target-temp"
            name="targetTemp"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 100"
            aria-describedby="heat-target-temp-hint heat-target-temp-error"
            data-field="targetTemp"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
          <p id="heat-target-temp-hint" class="mt-1.5 text-sm text-ink-subtle">
            Maximum allowed target is 104°F / 40°C. That is a maximum, not a recommended target for
            everyone.
          </p>
          <p
            id="heat-target-temp-error"
            class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
            data-error-for="targetTemp"
            role="alert"
          ></p>
        </div>
      </div>
      <div class="mt-4">
        <label for="heat-temp-unit" class="block text-sm font-medium text-ink">Temperature unit</label>
        <select
          id="heat-temp-unit"
          name="tempUnit"
          data-temp-unit
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        >
          <option value="F" selected>Fahrenheit (°F)</option>
          <option value="C">Celsius (°C)</option>
        </select>
      </div>
    </div>

    <div data-heater-mode-wrap>
      <div>
        <label for="heat-capacity" class="block text-sm font-medium text-ink">Hot tub water capacity</label>
        <div class="mt-2 grid gap-3 sm:grid-cols-[minmax(0,1fr)_11rem]">
          <input
            id="heat-capacity"
            name="capacity"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 400"
            aria-describedby="heat-capacity-hint heat-capacity-error"
            data-field="capacity"
            class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
          <select
            id="heat-capacity-unit"
            name="capacityUnit"
            data-capacity-unit
            aria-label="Capacity unit"
            class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <option value="gal" selected>U.S. gallons</option>
            <option value="L">Liters</option>
          </select>
        </div>
        <p id="heat-capacity-hint" class="mt-1.5 text-sm text-ink-subtle">
          Prefer the manufacturer&apos;s listed capacity. If needed, estimate with the
          <a
            href="/calculators/hot-tub-volume-calculator"
            class="font-medium text-brand-dark underline-offset-2 hover:underline"
            >Hot Tub Volume Calculator</a
          >.
        </p>
        <p
          id="heat-capacity-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="capacity"
          role="alert"
        ></p>
      </div>

      <fieldset class="mt-6">
        <legend class="font-display text-lg font-semibold text-ink">Heater power</legend>
        <p class="mt-2 text-sm text-ink-subtle">
          Obtain the heater rating from your model&apos;s documentation. Do not infer wattage from
          supply voltage alone, and do not open electrical equipment to read a rating.
        </p>
        <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4" role="radiogroup" aria-label="Heater power">
          {
            heaterPresets.map((preset) => (
              <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft">
                <input
                  type="radio"
                  name="heaterPreset"
                  value={preset}
                  checked={preset === '4'}
                  class="h-4 w-4 accent-brand"
                  data-heater-preset
                />
                <span class="text-base font-medium text-ink">{preset} kW</span>
              </label>
            ))
          }
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft sm:col-span-2"
          >
            <input
              type="radio"
              name="heaterPreset"
              value="custom"
              class="h-4 w-4 accent-brand"
              data-heater-preset
            />
            <span class="text-base font-medium text-ink">Custom</span>
          </label>
        </div>
        <div class="mt-3 hidden" data-custom-heater-wrap>
          <label for="heat-custom-kw" class="block text-sm font-medium text-ink"
            >Custom heater power (kW)</label
          >
          <input
            id="heat-custom-kw"
            name="customHeaterKw"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 3.75"
            aria-describedby="heat-heater-error"
            data-field="heaterPower"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
          />
        </div>
        <p
          id="heat-heater-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="heaterPower"
          role="alert"
        ></p>
      </fieldset>

      <fieldset class="mt-6 rounded-xl border border-border/80 bg-surface/60 p-4 sm:p-5">
        <legend class="px-1 font-display text-base font-semibold text-ink">
          Illustrative heat-loss adjustment (optional)
        </legend>
        <p class="mt-1 text-sm text-ink-subtle">
          These percentages are planning assumptions only. They are not measured values and are not
          typical for every hot tub. Default is the ideal calculation with no adjustment.
        </p>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Heat-loss assumption">
          {
            heatLossPresets.map((preset) => (
              <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft">
                <input
                  type="radio"
                  name="heatLossPreset"
                  value={preset}
                  checked={preset === 'none'}
                  class="h-4 w-4 accent-brand"
                  data-heat-loss-preset
                />
                <span class="text-base font-medium text-ink">{HEAT_LOSS_PRESET_LABELS[preset]}</span>
              </label>
            ))
          }
        </div>
        <div class="mt-3 hidden" data-custom-heat-loss-wrap>
          <label for="heat-custom-loss" class="block text-sm font-medium text-ink"
            >Custom heat-loss percentage</label
          >
          <input
            id="heat-custom-loss"
            name="customHeatLossPercent"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 15"
            aria-describedby="heat-loss-error"
            data-field="heatLoss"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
          />
        </div>
        <p
          id="heat-loss-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="heatLoss"
          role="alert"
        ></p>
      </fieldset>

      <fieldset class="mt-6 rounded-xl border border-border/80 bg-surface/60 p-4 sm:p-5">
        <legend class="px-1 font-display text-base font-semibold text-ink">
          Electricity rate (optional)
        </legend>
        <p class="mt-1 text-sm text-ink-subtle">
          Optional. Used only to estimate heater electricity cost for this one heat-up. Leave blank
          to skip cost. Does not include pumps or accessories.
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-[minmax(0,1fr)_14rem]">
          <div>
            <label for="heat-elec-rate" class="block text-sm font-medium text-ink"
              >Electricity rate</label
            >
            <input
              id="heat-elec-rate"
              name="electricityRate"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="e.g. 0.15"
              aria-describedby="heat-elec-rate-hint heat-elec-rate-error"
              data-field="electricityRate"
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            />
          </div>
          <div>
            <label for="heat-elec-rate-unit" class="block text-sm font-medium text-ink">Rate unit</label>
            <select
              id="heat-elec-rate-unit"
              name="electricityRateUnit"
              data-elec-rate-unit
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            >
              <option value="per_kwh" selected>Dollars per kWh ($/kWh)</option>
              <option value="cents_per_kwh">Cents per kWh (¢/kWh)</option>
            </select>
          </div>
        </div>
        <p id="heat-elec-rate-hint" class="mt-1.5 text-sm text-ink-subtle">
          Use the rate on your utility bill. For ongoing operating cost across many days, use the
          <a
            href="/calculators/hot-tub-electricity-cost-calculator"
            class="font-medium text-brand-dark underline-offset-2 hover:underline"
            >Hot Tub Electricity Cost Calculator</a
          >.
        </p>
        <p
          id="heat-elec-rate-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="electricityRate"
          role="alert"
        ></p>
      </fieldset>
    </div>

    <div class="hidden" data-measured-mode-wrap>
      <fieldset>
        <legend class="font-display text-lg font-semibold text-ink">Observed heating</legend>
        <p class="mt-2 text-sm text-ink-subtle">
          Record the temperature rise over a timed interval with the cover on and normal heating
          conditions. Extrapolation assumes similar operating and environmental conditions continue.
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="heat-observed-rise" class="block text-sm font-medium text-ink"
              >Observed temperature increase</label
            >
            <input
              id="heat-observed-rise"
              name="observedRise"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="e.g. 5"
              aria-describedby="heat-observed-rise-hint heat-observed-rise-error"
              data-field="observedRise"
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            />
            <p id="heat-observed-rise-hint" class="mt-1.5 text-sm text-ink-subtle">
              Enter the rise in the same temperature unit selected above.
            </p>
            <p
              id="heat-observed-rise-error"
              class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
              data-error-for="observedRise"
              role="alert"
            ></p>
          </div>
          <div>
            <label for="heat-observation-duration" class="block text-sm font-medium text-ink"
              >Measurement duration</label
            >
            <div class="mt-2 grid gap-3 sm:grid-cols-[minmax(0,1fr)_9rem]">
              <input
                id="heat-observation-duration"
                name="observationDuration"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 2"
                aria-describedby="heat-observation-duration-error"
                data-field="observationDuration"
                class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <select
                id="heat-observation-unit"
                name="observationUnit"
                data-observation-unit
                aria-label="Measurement duration unit"
                class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              >
                <option value="hours" selected>Hours</option>
                <option value="minutes">Minutes</option>
              </select>
            </div>
            <p
              id="heat-observation-duration-error"
              class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
              data-error-for="observationDuration"
              role="alert"
            ></p>
          </div>
        </div>
        <p class="mt-3 text-sm text-ink-muted">
          Measured-rate mode does not estimate electricity use or cost without separate heater-power
          information. If temperature does not rise, see
          <a
            href="/troubleshooting/why-is-my-hot-tub-taking-so-long-to-heat-up"
            class="font-medium text-brand-dark underline-offset-2 hover:underline"
            >Why Is My Hot Tub Taking So Long to Heat Up?</a
          >
          or
          <a
            href="/troubleshooting/hot-tub-not-heating"
            class="font-medium text-brand-dark underline-offset-2 hover:underline"
            >Hot Tub Not Heating</a
          >.
        </p>
      </fieldset>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <button
        type="submit"
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand px-5 text-base font-medium text-white transition-colors hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Estimate heat-up time
      </button>
      <button
        type="button"
        data-reset
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-border bg-surface px-5 text-base font-medium text-ink transition-colors hover:border-brand/40 hover:bg-brand-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Reset
      </button>
    </div>
  </form>

  <div
    class="mt-6 hidden rounded-2xl border border-brand/25 bg-brand-soft p-5 sm:p-6"
    data-result
    aria-live="polite"
    aria-atomic="true"
  ></div>
</div>

<script>
  import {
    calculateHeatUpTime,
    formatCurrencyUsd,
    formatKwh,
    formatRate,
    type CapacityUnit,
    type DurationUnit,
    type HeatLossPreset,
    type HeatUpFieldKey,
    type HeatUpMode,
    type HeatUpResult,
    type HeaterPreset,
    type RateUnit,
    type TempUnit,
  } from '../utils/hot-tub-heat-up-time';

  function initCalculator(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-heat-up-form]');
    const resultEl = root.querySelector<HTMLElement>('[data-result]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
    const heaterWrap = root.querySelector<HTMLElement>('[data-heater-mode-wrap]');
    const measuredWrap = root.querySelector<HTMLElement>('[data-measured-mode-wrap]');
    const customHeaterWrap = root.querySelector<HTMLElement>('[data-custom-heater-wrap]');
    const customHeatLossWrap = root.querySelector<HTMLElement>('[data-custom-heat-loss-wrap]');
    const capacityUnit = root.querySelector<HTMLSelectElement>('[data-capacity-unit]');
    const tempUnit = root.querySelector<HTMLSelectElement>('[data-temp-unit]');
    const observationUnit = root.querySelector<HTMLSelectElement>('[data-observation-unit]');
    const elecRateUnit = root.querySelector<HTMLSelectElement>('[data-elec-rate-unit]');
    const modeInputs = root.querySelectorAll<HTMLInputElement>('[data-heat-mode]');
    const heaterPresetInputs = root.querySelectorAll<HTMLInputElement>('[data-heater-preset]');
    const heatLossPresetInputs = root.querySelectorAll<HTMLInputElement>('[data-heat-loss-preset]');

    if (
      !form ||
      !resultEl ||
      !resetBtn ||
      !heaterWrap ||
      !measuredWrap ||
      !customHeaterWrap ||
      !customHeatLossWrap ||
      !capacityUnit ||
      !tempUnit ||
      !observationUnit ||
      !elecRateUnit
    ) {
      return;
    }

    const fieldOrder: HeatUpFieldKey[] = [
      'capacity',
      'currentTemp',
      'targetTemp',
      'heaterPower',
      'heatLoss',
      'observedRise',
      'observationDuration',
      'electricityRate',
    ];

    function currentMode(): HeatUpMode {
      const checked = form!.querySelector<HTMLInputElement>('input[name="heatUpMode"]:checked');
      return checked?.value === 'measured' ? 'measured' : 'heater';
    }

    function currentHeaterPreset(): HeaterPreset {
      const checked = form!.querySelector<HTMLInputElement>('input[name="heaterPreset"]:checked');
      const value = checked?.value;
      if (
        value === '1' ||
        value === '1.5' ||
        value === '2' ||
        value === '3' ||
        value === '4' ||
        value === '5.5' ||
        value === '6' ||
        value === 'custom'
      ) {
        return value;
      }
      return '4';
    }

    function currentHeatLossPreset(): HeatLossPreset {
      const checked = form!.querySelector<HTMLInputElement>('input[name="heatLossPreset"]:checked');
      const value = checked?.value;
      if (value === '10' || value === '20' || value === '30' || value === 'custom') return value;
      return 'none';
    }

    function syncMode() {
      const isHeater = currentMode() === 'heater';
      heaterWrap!.hidden = !isHeater;
      heaterWrap!.classList.toggle('hidden', !isHeater);
      measuredWrap!.hidden = isHeater;
      measuredWrap!.classList.toggle('hidden', isHeater);

      for (const field of [
        'capacity',
        'heaterPower',
        'heatLoss',
        'electricityRate',
        'observedRise',
        'observationDuration',
      ] as const) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
        if (!input) continue;
        if (field === 'observedRise' || field === 'observationDuration') {
          input.disabled = isHeater;
        } else if (field === 'heaterPower' || field === 'heatLoss') {
          // enabled state handled by preset sync when in heater mode
          input.disabled = !isHeater;
        } else {
          input.disabled = !isHeater;
        }
      }
      capacityUnit!.disabled = !isHeater;
      observationUnit!.disabled = isHeater;
      elecRateUnit!.disabled = !isHeater;
      syncHeaterPreset();
      syncHeatLossPreset();
    }

    function syncHeaterPreset() {
      const isCustom = currentMode() === 'heater' && currentHeaterPreset() === 'custom';
      customHeaterWrap!.hidden = !isCustom;
      customHeaterWrap!.classList.toggle('hidden', !isCustom);
      const input = form!.querySelector<HTMLInputElement>('[data-field="heaterPower"]');
      if (input) input.disabled = !isCustom;
    }

    function syncHeatLossPreset() {
      const isCustom = currentMode() === 'heater' && currentHeatLossPreset() === 'custom';
      customHeatLossWrap!.hidden = !isCustom;
      customHeatLossWrap!.classList.toggle('hidden', !isCustom);
      const input = form!.querySelector<HTMLInputElement>('[data-field="heatLoss"]');
      if (input) input.disabled = !isCustom;
    }

    function clearErrors() {
      for (const field of fieldOrder) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
        const error = form!.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (input) {
          input.removeAttribute('aria-invalid');
          input.classList.remove('border-[#c45c4a]');
        }
        if (error) {
          error.textContent = '';
          error.classList.add('hidden');
        }
      }
    }

    function showErrors(errors: { field: HeatUpFieldKey; message: string }[]) {
      clearErrors();
      for (const error of errors) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${error.field}"]`);
        const errorEl = form!.querySelector<HTMLElement>(`[data-error-for="${error.field}"]`);
        if (input && !input.disabled) {
          input.setAttribute('aria-invalid', 'true');
          input.classList.add('border-[#c45c4a]');
        }
        if (errorEl) {
          errorEl.textContent = error.message;
          errorEl.classList.remove('hidden');
        }
      }
      const first = errors[0];
      if (!first) return;
      const firstInput = form!.querySelector<HTMLInputElement>(`[data-field="${first.field}"]`);
      if (firstInput && !firstInput.disabled) {
        firstInput.focus();
        return;
      }
      if (first.field === 'heaterPower') {
        form!.querySelector<HTMLInputElement>('input[name="heaterPreset"][value="custom"]')?.focus();
      }
      if (first.field === 'heatLoss') {
        form!.querySelector<HTMLInputElement>('input[name="heatLossPreset"][value="custom"]')?.focus();
      }
    }

    function clearResult() {
      resultEl!.hidden = true;
      resultEl!.classList.add('hidden');
      resultEl!.innerHTML = '';
    }

    function escapeHtml(value: string): string {
      return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderResult(data: HeatUpResult) {
      if (data.alreadyAtOrAboveTarget) {
        resultEl!.innerHTML = `
          <h2 class="font-display text-xl font-semibold text-ink">Heat-up estimate</h2>
          <p class="mt-4 text-2xl font-semibold text-ink sm:text-3xl">
            No additional heating is required
          </p>
          <p class="mt-2 text-base leading-relaxed text-ink-muted">
            Current temperature (${escapeHtml(data.inputsSummary.currentTempLabel)}) is already at or
            above the target (${escapeHtml(data.inputsSummary.targetTempLabel)}). This calculator does
            not estimate cooling time.
          </p>
          <div class="mt-5 rounded-xl border border-warning-border bg-warning-bg p-4 text-sm leading-relaxed text-warning-ink" role="note">
            <p>
              Verify actual water temperature with a suitable thermometer before entering. Follow your
              manufacturer’s temperature limits. Calculator results do not establish that water is
              chemically safe to use.
            </p>
          </div>
        `;
        resultEl!.hidden = false;
        resultEl!.classList.remove('hidden');
        return;
      }

      const unitSymbol = data.tempUnit === 'F' ? '°F' : '°C';
      const rateBlock =
        data.heatingRatePerHourDisplay !== null
          ? `<p class="mt-3 text-base text-ink">
              About ${escapeHtml(formatRate(data.heatingRatePerHourDisplay))}${unitSymbol} per hour
            </p>`
          : '';

      const idealBlock =
        data.mode === 'heater' && data.idealDurationLabel
          ? `<p class="mt-2 text-sm text-ink-muted">
              Ideal minimum (no heat-loss adjustment): ${escapeHtml(data.idealDurationLabel)}
            </p>`
          : '';

      const energyBlock =
        data.mode === 'heater' && data.thermalEnergyKWh !== null
          ? `<div class="mt-5 border-t border-brand/20 pt-4 space-y-2 text-sm text-ink-muted">
              <p>
                <span class="font-medium text-ink">Thermal energy required:</span>
                about ${escapeHtml(formatKwh(data.thermalEnergyKWh))} kWh delivered to the water
              </p>
              <p>
                <span class="font-medium text-ink">Estimated heater electricity:</span>
                about ${escapeHtml(formatKwh(data.estimatedHeaterEnergyKWh ?? 0))} kWh
                (heater power × estimated hours; excludes pumps and accessories)
              </p>
              ${
                data.estimatedHeaterCostUsd !== null
                  ? `<p>
                      <span class="font-medium text-ink">Estimated heater cost:</span>
                      about ${escapeHtml(formatCurrencyUsd(data.estimatedHeaterCostUsd))}
                      for this heat-up
                    </p>`
                  : `<p>Heater cost unavailable — no electricity rate was entered.</p>`
              }
            </div>`
          : `<p class="mt-5 border-t border-brand/20 pt-4 text-sm text-ink-muted">
              Measured-rate mode extrapolates remaining time only. Electricity use and cost are not
              estimated without separate heater-power information.
            </p>`;

      const measuredNote =
        data.mode === 'measured'
          ? `<p class="mt-3 text-sm text-ink-muted">
              Extrapolation assumes similar cover use, set temperature, flow, and environmental
              conditions continue for the remaining climb.
            </p>`
          : '';

      resultEl!.innerHTML = `
        <h2 class="font-display text-xl font-semibold text-ink">Heat-up estimate</h2>
        <p class="mt-4 text-2xl font-semibold text-ink sm:text-3xl">
          About ${escapeHtml(data.durationLabel ?? '')}
        </p>
        ${idealBlock}
        ${rateBlock}
        ${measuredNote}
        <p class="mt-4 text-base leading-relaxed text-ink-muted">
          This is a planning estimate, not a guarantee of heating performance and not a diagnosis of
          a heating fault.
        </p>
        <div class="mt-5 rounded-xl border border-warning-border bg-warning-bg p-4 text-sm leading-relaxed text-warning-ink" role="note">
          <p>
            <strong class="font-semibold">Safety:</strong>
            104°F (40°C) is a maximum water temperature guidance point, not a recommended target for
            everyone. Follow the manufacturer’s temperature and operating limits. Verify actual water
            temperature before entering. Never bypass temperature controls or safety devices to
            accelerate heating. Do not energize an empty or improperly filled spa. Do not open
            electrical equipment to determine heater wattage.
          </p>
          <p class="mt-3">
            Calculator results do not establish that water is chemically safe to use.
          </p>
        </div>
        ${energyBlock}
        <dl class="mt-5 space-y-2 text-sm text-ink-muted">
          <div>
            <dt class="inline font-medium text-ink">Mode:</dt>
            <dd class="inline"> ${escapeHtml(data.inputsSummary.modeLabel)}</dd>
          </div>
          ${
            data.inputsSummary.capacityLabel
              ? `<div>
                  <dt class="inline font-medium text-ink">Capacity:</dt>
                  <dd class="inline"> ${escapeHtml(data.inputsSummary.capacityLabel)}</dd>
                </div>`
              : ''
          }
          <div>
            <dt class="inline font-medium text-ink">Current / target:</dt>
            <dd class="inline">
              ${escapeHtml(data.inputsSummary.currentTempLabel)} →
              ${escapeHtml(data.inputsSummary.targetTempLabel)}
            </dd>
          </div>
          ${
            data.inputsSummary.heaterLabel
              ? `<div>
                  <dt class="inline font-medium text-ink">Heater:</dt>
                  <dd class="inline"> ${escapeHtml(data.inputsSummary.heaterLabel)}</dd>
                </div>`
              : ''
          }
          ${
            data.inputsSummary.heatLossLabel
              ? `<div>
                  <dt class="inline font-medium text-ink">Heat-loss assumption:</dt>
                  <dd class="inline"> ${escapeHtml(data.inputsSummary.heatLossLabel)}</dd>
                </div>`
              : ''
          }
          ${
            data.inputsSummary.measuredLabel
              ? `<div>
                  <dt class="inline font-medium text-ink">Observation:</dt>
                  <dd class="inline"> ${escapeHtml(data.inputsSummary.measuredLabel)}</dd>
                </div>`
              : ''
          }
        </dl>
      `;
      resultEl!.hidden = false;
      resultEl!.classList.remove('hidden');
    }

    modeInputs.forEach((input) => {
      input.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncMode();
      });
    });

    heaterPresetInputs.forEach((input) => {
      input.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncHeaterPreset();
      });
    });

    heatLossPresetInputs.forEach((input) => {
      input.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncHeatLossPreset();
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const outcome = calculateHeatUpTime({
        mode: currentMode(),
        capacity: form.querySelector<HTMLInputElement>('[data-field="capacity"]')?.value ?? '',
        capacityUnit: capacityUnit.value as CapacityUnit,
        currentTemp: form.querySelector<HTMLInputElement>('[data-field="currentTemp"]')?.value ?? '',
        targetTemp: form.querySelector<HTMLInputElement>('[data-field="targetTemp"]')?.value ?? '',
        tempUnit: tempUnit.value as TempUnit,
        heaterPreset: currentHeaterPreset(),
        customHeaterKw: form.querySelector<HTMLInputElement>('[data-field="heaterPower"]')?.value ?? '',
        heatLossPreset: currentHeatLossPreset(),
        customHeatLossPercent:
          form.querySelector<HTMLInputElement>('[data-field="heatLoss"]')?.value ?? '',
        observedRise: form.querySelector<HTMLInputElement>('[data-field="observedRise"]')?.value ?? '',
        observationDuration:
          form.querySelector<HTMLInputElement>('[data-field="observationDuration"]')?.value ?? '',
        observationUnit: observationUnit.value as DurationUnit,
        electricityRate:
          form.querySelector<HTMLInputElement>('[data-field="electricityRate"]')?.value ?? '',
        electricityRateUnit: elecRateUnit.value as RateUnit,
      });

      if (!outcome.ok) {
        clearResult();
        showErrors(outcome.errors);
        return;
      }

      clearErrors();
      renderResult(outcome.result);
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      const heaterMode = form.querySelector<HTMLInputElement>('input[name="heatUpMode"][value="heater"]');
      const heater4 = form.querySelector<HTMLInputElement>('input[name="heaterPreset"][value="4"]');
      const lossNone = form.querySelector<HTMLInputElement>('input[name="heatLossPreset"][value="none"]');
      if (heaterMode) heaterMode.checked = true;
      if (heater4) heater4.checked = true;
      if (lossNone) lossNone.checked = true;
      capacityUnit.value = 'gal';
      tempUnit.value = 'F';
      observationUnit.value = 'hours';
      elecRateUnit.value = 'per_kwh';
      clearErrors();
      clearResult();
      syncMode();
      form.querySelector<HTMLInputElement>('[data-field="currentTemp"]')?.focus();
    });

    syncMode();
  }

  document.querySelectorAll<HTMLElement>('[data-heat-up-calculator]').forEach(initCalculator);
</script>
