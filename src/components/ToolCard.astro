---
interface Props {
  title: string;
  description: string;
  status?: 'available' | 'coming-soon';
  href?: string;
}

const { title, description, status = 'coming-soon', href } = Astro.props;
const isAvailable = status === 'available' && Boolean(href);
---

<div
  class="flex h-full flex-col rounded-2xl bg-surface-raised p-7 shadow-[0_1px_2px_rgba(26,43,60,0.04)] ring-1 ring-border/70"
>
  <h3 class="font-display text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-2 flex-1 text-base leading-relaxed text-ink-muted">{description}</p>
  {
    isAvailable ? (
      <a
        href={href}
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-brand px-4 text-base font-medium text-white no-underline transition-colors hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Open tool
      </a>
    ) : (
      <button
        type="button"
        disabled
        class="mt-6 inline-flex min-h-11 cursor-not-allowed items-center justify-center rounded-xl bg-sand px-4 text-base font-medium text-ink-subtle"
      >
        Coming Soon
      </button>
    )
  }
</div>
