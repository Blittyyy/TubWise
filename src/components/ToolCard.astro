---
interface Props {
  title: string;
  description: string;
  status?: 'available' | 'coming-soon';
  icon?: 'volume' | 'electric' | 'schedule' | 'lookup';
}

const { title, description, status = 'coming-soon', icon = 'volume' } = Astro.props;

const icons = {
  volume: `<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>`,
  electric: `<path d="M13 2 4 14h7l-1 8 10-14h-7l0-6Z"/>`,
  schedule: `<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/><path d="M8 14h3M8 17h6"/>`,
  lookup: `<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M8 11h6"/>`,
};
---

<div
  class="flex h-full flex-col rounded-2xl bg-surface-raised p-7 shadow-[0_1px_2px_rgba(26,43,60,0.04)] ring-1 ring-border/70"
>
  <span
    class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand text-white"
    aria-hidden="true"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-7 w-7"
      set:html={icons[icon]}
    />
  </span>
  <h3 class="font-display text-xl font-semibold text-ink">{title}</h3>
  <p class="mt-2 flex-1 text-base leading-relaxed text-ink-muted">{description}</p>
  {
    status === 'coming-soon' ? (
      <button
        type="button"
        disabled
        class="mt-6 inline-flex min-h-11 cursor-not-allowed items-center justify-center rounded-xl bg-sand px-4 text-base font-medium text-ink-subtle"
      >
        Coming Soon
      </button>
    ) : (
      <span class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-brand px-4 text-base font-medium text-white">
        Open tool
      </span>
    )
  }
</div>
