---
import Wordmark from './Wordmark.astro';
import { primaryNav, footerLegal } from '../data/navigation';
import { SITE_TAGLINE } from '../utils/site';

const year = new Date().getFullYear();
---

<footer class="bg-navy text-white">
  <div class="container-site py-16 sm:py-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <a href="/" class="inline-block no-underline" aria-label="TubWise home">
          <Wordmark
            size="lg"
            class="text-[1.75rem] text-white [&_span]:text-[#8ec4ce]"
          />
        </a>
        <p class="mt-4 max-w-xs text-base leading-relaxed text-white/70">
          {SITE_TAGLINE}
        </p>
        <p class="mt-3 max-w-xs text-base leading-relaxed text-white/55">
          Practical guidance for hot tub owners — from cloudy water to error codes.
        </p>
      </div>

      <div>
        <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white/50">
          Categories
        </h2>
        <ul class="mt-5 space-y-3">
          {
            primaryNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-base text-white/75 no-underline transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white/50">
          Company
        </h2>
        <ul class="mt-5 space-y-3">
          {
            footerLegal.slice(0, 2).map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-base text-white/75 no-underline transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.14em] text-white/50">
          Legal
        </h2>
        <ul class="mt-5 space-y-3">
          {
            footerLegal.slice(2).map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-base text-white/75 no-underline transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-8 text-base text-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} TubWise. All rights reserved.</p>
      <p>Guidance for homeowners — not a substitute for professional service.</p>
    </div>
  </div>
</footer>
