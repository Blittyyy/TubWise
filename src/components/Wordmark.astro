---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', size = 'md' } = Astro.props;

const sizes = {
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-2xl sm:text-3xl',
};
---

<span
  class:list={[
    'font-display font-semibold tracking-tight text-ink',
    sizes[size],
    className,
  ]}
>
  Tub<span class="text-brand">Wise</span>
</span>
