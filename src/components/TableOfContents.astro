---
interface TocItem {
  id: string;
  label: string;
}

interface Props {
  items: TocItem[];
  title?: string;
}

const { items, title = 'On this page' } = Astro.props;
---

{
  items.length > 0 && (
    <nav
      aria-label="Table of contents"
      class="rounded-xl border border-border bg-surface-raised p-5"
    >
      <h2 class="font-sans text-sm font-semibold uppercase tracking-wide text-ink">
        {title}
      </h2>
      <ol class="mt-3 space-y-2">
        {items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="text-sm text-ink-muted no-underline hover:text-brand"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
