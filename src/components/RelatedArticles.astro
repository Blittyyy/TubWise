---
import ArticleCard from './ArticleCard.astro';
import type { ArticleEntry } from '../utils/articles';
import { articlePath, categoryMeta } from '../utils/articles';

interface Props {
  articles: ArticleEntry[];
  heading?: string;
}

const { articles, heading = 'Related articles' } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="mt-12 border-t border-border pt-10" aria-labelledby="related-heading">
      <h2 id="related-heading" class="font-display text-2xl font-semibold text-ink">
        {heading}
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {articles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={articlePath(article)}
            category={categoryMeta[article.data.category].label}
          />
        ))}
      </div>
    </section>
  )
}
