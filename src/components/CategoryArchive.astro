---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ArticleCard from './ArticleCard.astro';
import SafetyCallout from './SafetyCallout.astro';
import AffiliateDisclosure from './AffiliateDisclosure.astro';
import type { ArticleCategory } from '../content.config';
import {
  articlePath,
  categoryMeta,
  getArticlesByCategory,
} from '../utils/articles';
import { isNoindexPath } from '../utils/indexing';
import { breadcrumbSchema, categoryHubSchema } from '../utils/schema';

interface ArticleGroup {
  label: string;
  subcategories: string[];
}

interface Props {
  category: ArticleCategory;
  showSafety?: boolean;
  showAffiliate?: boolean;
  noindex?: boolean;
  robotsFollow?: boolean;
  /** Optional subcategory groups. Only groups with published articles are shown. */
  articleGroups?: ArticleGroup[];
}

const {
  category,
  showSafety = true,
  showAffiliate = false,
  noindex: noindexProp,
  robotsFollow = false,
  articleGroups,
} = Astro.props;
const meta = categoryMeta[category];
const articles = await getArticlesByCategory(category);
const groupedSections =
  articleGroups?.map((group) => ({
    label: group.label,
    articles: articles.filter((article) =>
      group.subcategories.includes(article.data.subcategory ?? ''),
    ),
  })).filter((group) => group.articles.length > 0) ?? [];
const groupedSlugs = new Set(
  groupedSections.flatMap((group) => group.articles.map((article) => article.data.slug)),
);
const ungroupedArticles = articles.filter((article) => !groupedSlugs.has(article.data.slug));
const hasSearchQuery = Astro.url.searchParams.has('q');
const noindex = noindexProp ?? (isNoindexPath(meta.href) || hasSearchQuery);

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: meta.label }];
const schemas = [categoryHubSchema(category, meta.href), breadcrumbSchema(breadcrumbs)];
---

<BaseLayout
  title={meta.label}
  description={meta.description}
  path={meta.href}
  noindex={noindex}
  robotsFollow={hasSearchQuery || robotsFollow}
  schema={schemas}
>
  <div class="container-site section-space">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mb-8 max-w-3xl">
      <h1 class="text-3xl font-semibold sm:text-4xl">{meta.label}</h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-muted">{meta.description}</p>
    </header>

    <div class="prose-site max-w-3xl">
      <slot />
    </div>

    <section class="mt-12" aria-labelledby="articles-heading">
      <h2 id="articles-heading" class="font-display text-2xl font-semibold text-ink">
        Articles
      </h2>

      {
        articles.length === 0 ? (
          <p class="mt-4 max-w-3xl text-ink-muted">
            No published articles in this category yet. New guides will appear here
            automatically once they are added to the content collection and marked as
            published.
          </p>
        ) : groupedSections.length > 0 ? (
          <div class="mt-6 space-y-10">
            {groupedSections.map((group) => (
              <div>
                <h3 class="font-display text-lg font-semibold text-ink">{group.label}</h3>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {group.articles.map((article) => (
                    <ArticleCard
                      title={article.data.title}
                      description={article.data.description}
                      href={articlePath(article)}
                      category={meta.label}
                    />
                  ))}
                </div>
              </div>
            ))}
            {ungroupedArticles.length > 0 && (
              <div>
                <h3 class="font-display text-lg font-semibold text-ink">More guides</h3>
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {ungroupedArticles.map((article) => (
                    <ArticleCard
                      title={article.data.title}
                      description={article.data.description}
                      href={articlePath(article)}
                      category={meta.label}
                    />
                  ))}
                </div>
              </div>
            )}
          </div>
        ) : (
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={articlePath(article)}
                category={meta.label}
              />
            ))}
          </div>
        )
      }
    </section>

    {
      showSafety && (
        <div class="mt-12 max-w-3xl">
          <SafetyCallout />
        </div>
      )
    }

    {
      showAffiliate && (
        <div class="mt-8 max-w-3xl">
          <AffiliateDisclosure />
        </div>
      )
    }
  </div>
</BaseLayout>
