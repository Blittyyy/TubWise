---
interface Props {
  placeholder?: string;
  size?: 'sm' | 'lg' | 'hero';
  autofocus?: boolean;
  class?: string;
  comingSoon?: boolean;
  variant?: 'default' | 'on-dark';
  showTopics?: boolean;
}

const {
  placeholder = 'What problem are you having?',
  size = 'sm',
  autofocus = false,
  class: className = '',
  comingSoon = true,
  variant = 'default',
  showTopics = false,
} = Astro.props;

const inputId = `search-${Math.random().toString(36).slice(2, 9)}`;
const isHero = size === 'hero';
const topics = ['cloudy water', 'not heating', 'FLO error', 'leaking pump'];
---

<div class:list={['w-full', className]} role="search" aria-label="Search TubWise">
  <label for={inputId} class="sr-only">Search TubWise</label>
  <div
    class:list={[
      'flex items-center overflow-hidden',
      isHero
        ? 'min-h-14 rounded-lg border border-[#d8d5cf] bg-white sm:min-h-[3.75rem]'
        : variant === 'on-dark'
          ? 'min-h-11 rounded-xl border border-white/15 bg-white/10'
          : 'min-h-11 rounded-xl border border-border bg-surface-raised',
      size === 'lg' && !isHero ? 'min-h-14' : '',
      comingSoon ? 'cursor-not-allowed' : '',
    ]}
  >
    <span
      class:list={[
        'flex items-center',
        isHero ? 'pl-4 text-[#3d7a86] sm:pl-5' : variant === 'on-dark' ? 'pl-3 text-white/70' : 'pl-3 text-ink-subtle',
      ]}
      aria-hidden="true"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={isHero ? 'h-5 w-5 sm:h-6 sm:w-6' : 'h-4 w-4'}
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </span>

    {
      comingSoon ? (
        <input
          id={inputId}
          type="search"
          placeholder={placeholder}
          disabled
          aria-disabled="true"
          aria-describedby={`${inputId}-status`}
          class:list={[
            'w-full cursor-not-allowed border-0 bg-transparent focus:outline-none',
            isHero
              ? 'px-3 py-3.5 text-base text-ink-muted placeholder:text-ink-subtle sm:px-4 sm:text-lg'
              : variant === 'on-dark'
                ? 'px-3 text-sm text-white/70 placeholder:text-white/45'
                : 'px-3 text-sm text-ink-muted placeholder:text-ink-subtle sm:text-base',
          ]}
        />
      ) : (
        <form action="/search" method="get" class="flex w-full items-stretch">
          <input
            id={inputId}
            type="search"
            name="q"
            placeholder={placeholder}
            autofocus={autofocus}
            class:list={[
              'w-full border-0 bg-transparent text-ink placeholder:text-ink-subtle focus:outline-none',
              isHero ? 'px-4 text-lg sm:text-xl' : 'px-3 text-sm sm:text-base',
            ]}
          />
          <button
            type="submit"
            class="shrink-0 bg-brand px-4 font-medium text-white transition-colors hover:bg-brand-dark"
          >
            Search
          </button>
        </form>
      )
    }
  </div>

  {
    comingSoon && (
      <p
        id={`${inputId}-status`}
        class:list={[
          'mt-2.5 text-sm',
          variant === 'on-dark' ? 'text-center text-white/80' : 'text-ink-subtle',
        ]}
      >
        Search coming soon
      </p>
    )
  }

  {
    showTopics && (
      <p
        class:list={[
          'mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm',
          variant === 'on-dark' ? 'justify-center text-white/75' : 'text-ink-muted',
        ]}
      >
        {topics.map((topic, index) => (
          <>
            {index > 0 && (
              <span aria-hidden="true" class={variant === 'on-dark' ? 'text-white/40' : 'text-ink-subtle'}>
                ·
              </span>
            )}
            <span>{topic}</span>
          </>
        ))}
      </p>
    )
  }
</div>
