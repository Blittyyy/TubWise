---
interface Props {
  title?: string;
}

const {
  title = 'When to call a professional',
} = Astro.props;
---

<aside
  class="rounded-xl border border-warning-border bg-warning-bg p-5 text-warning-ink"
  role="note"
>
  <h2 class="font-display text-lg font-semibold text-warning-ink">{title}</h2>
  <p class="mt-2 text-sm leading-relaxed">
    <slot>
      TubWise offers practical homeowner guidance. Stop and contact a qualified technician
      for electrical work, structural damage, gas equipment, persistent leaks, or any
      situation that could affect safety.
    </slot>
  </p>
</aside>
