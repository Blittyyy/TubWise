---
import type { HelpCategory } from '../data/categories';

interface Props {
  categories: HelpCategory[];
}

const { categories } = Astro.props;
---

<ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    categories.map((category) => (
      <li>
        <a
          href={category.href}
          class="group flex h-full flex-col rounded-2xl bg-surface-raised p-7 no-underline shadow-[0_1px_2px_rgba(26,43,60,0.04)] ring-1 ring-border/80 transition-shadow hover:shadow-[0_8px_24px_-12px_rgba(26,43,60,0.18)]"
        >
          <h3 class="font-display text-xl font-semibold text-ink group-hover:text-brand-dark">
            {category.title}
          </h3>
          <p class="mt-2 flex-1 text-base leading-relaxed text-ink-muted">
            {category.description}
          </p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-base font-medium text-brand">
            Explore
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
              &rarr;
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
