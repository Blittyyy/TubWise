---
import type { HelpCategory, HelpIcon } from '../data/categories';

interface Props {
  categories: HelpCategory[];
}

const { categories } = Astro.props;

const icons: Record<HelpIcon, string> = {
  water: `<path d="M12 2.7c.4.5 7 8.2 7 12.3a7 7 0 1 1-14 0c0-4.1 6.6-11.8 7-12.3Z"/><path d="M8.5 14.5c.6 2 2.1 3 3.5 3"/>`,
  heat: `<path d="M14 4v10.5a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"/>`,
  error: `<rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h8M8 13h5"/><circle cx="16.5" cy="13" r="1.25" fill="currentColor" stroke="none"/>`,
  leak: `<path d="M7 4v7.5a5 5 0 0 0 10 0V4"/><path d="M7 8h10"/><path d="M12 16.5v3.5"/><path d="M10 22h4"/>`,
  filter: `<path d="M4 5h16l-6 7.5V19l-4 2v-8.5L4 5Z"/>`,
  schedule: `<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 10h16"/><path d="M8 14h3M8 17h6"/>`,
};
---

<ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {
    categories.map((category) => {
      const iconKey = category.icon ?? 'water';
      return (
        <li>
          <a
            href={category.href}
            class="group flex h-full flex-col rounded-2xl bg-surface-raised p-7 no-underline shadow-[0_1px_2px_rgba(26,43,60,0.04)] ring-1 ring-border/80 transition-shadow hover:shadow-[0_8px_24px_-12px_rgba(26,43,60,0.18)]"
          >
            <span
              class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-soft text-brand"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-7 w-7"
                set:html={icons[iconKey]}
              />
            </span>
            <h3 class="font-display text-xl font-semibold text-ink group-hover:text-brand-dark">
              {category.title}
            </h3>
            <p class="mt-2 flex-1 text-base leading-relaxed text-ink-muted">
              {category.description}
            </p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-base font-medium text-brand">
              Explore
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
                &rarr;
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
