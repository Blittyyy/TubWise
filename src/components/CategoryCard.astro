---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a
  href={href}
  class="group block rounded-xl border border-border bg-surface-raised p-5 no-underline transition-colors hover:border-brand/40 hover:bg-brand-soft/40"
>
  <h3 class="font-display text-lg font-semibold text-ink group-hover:text-brand-dark">
    {title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-muted">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
    Explore
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5"
      >&rarr;</span
    >
  </span>
</a>
