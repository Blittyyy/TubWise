---
/**
 * Client-side hot tub electricity cost estimator.
 * Methods: equipment wattage/runtime, measured kWh, manufacturer standby label.
 * No storage, cookies, analytics, or network submission of measurements.
 */
---

<div
  class="not-prose rounded-2xl border border-border bg-surface-raised p-5 shadow-[0_1px_2px_rgba(26,43,60,0.04)] sm:p-7"
  data-electricity-calculator
>
  <form data-electricity-form class="space-y-6" novalidate>
    <fieldset>
      <legend class="font-display text-lg font-semibold text-ink">Estimation method</legend>
      <div class="mt-3 grid grid-cols-1 gap-2" role="radiogroup" aria-label="Estimation method">
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="estimationMethod"
            value="equipment"
            checked
            class="h-4 w-4 accent-brand"
            data-estimation-method
          />
          <span class="text-base font-medium text-ink">Equipment wattage and runtime</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="estimationMethod"
            value="measured"
            class="h-4 w-4 accent-brand"
            data-estimation-method
          />
          <span class="text-base font-medium text-ink">Measured electricity consumption</span>
        </label>
        <label
          class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
        >
          <input
            type="radio"
            name="estimationMethod"
            value="standby"
            class="h-4 w-4 accent-brand"
            data-estimation-method
          />
          <span class="text-base font-medium text-ink">Manufacturer energy-label (standby)</span>
        </label>
      </div>
      <p class="mt-2 text-sm text-ink-subtle">
        Only one estimation method is used at a time. Standby-label results are not combined with
        equipment wattage inputs.
      </p>
    </fieldset>

    <!-- Method A: Equipment -->
    <div data-method-panel="equipment" class="space-y-6">
      <fieldset>
        <legend class="font-display text-lg font-semibold text-ink">Equipment submode</legend>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2" role="radiogroup" aria-label="Equipment submode">
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
          >
            <input
              type="radio"
              name="mode"
              value="simple"
              checked
              class="h-4 w-4 accent-brand"
              data-mode-input
            />
            <span class="text-base font-medium text-ink">Simple estimate</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
          >
            <input
              type="radio"
              name="mode"
              value="detailed"
              class="h-4 w-4 accent-brand"
              data-mode-input
            />
            <span class="text-base font-medium text-ink">Detailed estimate</span>
          </label>
        </div>
        <p class="mt-2 text-sm text-ink-subtle">
          Simple mode covers the heater and circulation pump. Detailed mode adds optional jet pump,
          blower, and other loads.
        </p>
      </fieldset>

      <div>
        <label for="elec-power-unit" class="block text-sm font-medium text-ink">Power unit</label>
        <select
          id="elec-power-unit"
          name="powerUnit"
          data-power-unit
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        >
          <option value="W" selected>Watts (W)</option>
          <option value="kW">Kilowatts (kW)</option>
        </select>
        <p class="mt-1.5 text-sm text-ink-subtle">
          One unit applies to every equipment power field below. Do not estimate heater wattage from
          breaker rating or supply voltage.
        </p>
      </div>

      <div
        class="rounded-xl border border-warning-border bg-warning-bg p-4 text-sm leading-relaxed text-warning-ink"
        role="note"
      >
        <strong class="font-semibold">Active heating runtime:</strong>
        Heater runtime means the estimated time the heater is actively drawing its rated power—not
        simply the time the spa remains turned on. Rated wattage is not continuous use.
      </div>

      <fieldset class="space-y-4">
        <legend class="font-display text-lg font-semibold text-ink">Heater</legend>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="elec-heater-power" class="block text-sm font-medium text-ink"
              >Heater power</label
            >
            <input
              id="elec-heater-power"
              name="heaterPower"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="e.g. 4000"
              aria-describedby="elec-heater-power-hint elec-heater-power-error"
              data-field="heaterPower"
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            />
            <p id="elec-heater-power-hint" class="mt-1.5 text-sm text-ink-subtle">
              From the manual or nameplate
            </p>
            <p
              id="elec-heater-power-error"
              class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
              data-error-for="heaterPower"
              role="alert"
            ></p>
          </div>
          <div>
            <label for="elec-heater-runtime" class="block text-sm font-medium text-ink"
              >Heater runtime (hours/day)</label
            >
            <input
              id="elec-heater-runtime"
              name="heaterRuntime"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="e.g. 2"
              aria-describedby="elec-heater-runtime-hint elec-heater-runtime-error"
              data-field="heaterRuntime"
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            />
            <p id="elec-heater-runtime-hint" class="mt-1.5 text-sm text-ink-subtle">
              Active heating hours, up to 24
            </p>
            <p
              id="elec-heater-runtime-error"
              class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
              data-error-for="heaterRuntime"
              role="alert"
            ></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-4">
        <legend class="font-display text-lg font-semibold text-ink"
          >Circulation / filtration pump</legend
        >
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="elec-pump-power" class="block text-sm font-medium text-ink">Pump power</label>
            <input
              id="elec-pump-power"
              name="circulationPumpPower"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="e.g. 250"
              aria-describedby="elec-pump-power-hint elec-pump-power-error"
              data-field="circulationPumpPower"
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            />
            <p id="elec-pump-power-hint" class="mt-1.5 text-sm text-ink-subtle">
              Required in Simple mode; optional in Detailed mode
            </p>
            <p
              id="elec-pump-power-error"
              class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
              data-error-for="circulationPumpPower"
              role="alert"
            ></p>
          </div>
          <div>
            <label for="elec-pump-runtime" class="block text-sm font-medium text-ink"
              >Pump runtime (hours/day)</label
            >
            <input
              id="elec-pump-runtime"
              name="circulationPumpRuntime"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              placeholder="e.g. 8"
              aria-describedby="elec-pump-runtime-hint elec-pump-runtime-error"
              data-field="circulationPumpRuntime"
              class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
            />
            <p id="elec-pump-runtime-hint" class="mt-1.5 text-sm text-ink-subtle">
              Filtration schedule hours
            </p>
            <p
              id="elec-pump-runtime-error"
              class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
              data-error-for="circulationPumpRuntime"
              role="alert"
            ></p>
          </div>
        </div>
      </fieldset>

      <div class="space-y-6" data-detailed-fields hidden>
        <fieldset class="space-y-4">
          <legend class="font-display text-lg font-semibold text-ink">Jet pump (optional)</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="elec-jet-power" class="block text-sm font-medium text-ink"
                >Jet pump power</label
              >
              <input
                id="elec-jet-power"
                name="jetPumpPower"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 1000"
                aria-describedby="elec-jet-power-error"
                data-field="jetPumpPower"
                class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <p
                id="elec-jet-power-error"
                class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
                data-error-for="jetPumpPower"
                role="alert"
              ></p>
            </div>
            <div>
              <label for="elec-jet-runtime" class="block text-sm font-medium text-ink"
                >Jet pump runtime (hours/day)</label
              >
              <input
                id="elec-jet-runtime"
                name="jetPumpRuntime"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 1"
                aria-describedby="elec-jet-runtime-error"
                data-field="jetPumpRuntime"
                class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <p
                id="elec-jet-runtime-error"
                class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
                data-error-for="jetPumpRuntime"
                role="alert"
              ></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="space-y-4">
          <legend class="font-display text-lg font-semibold text-ink">Air blower (optional)</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="elec-blower-power" class="block text-sm font-medium text-ink"
                >Blower power</label
              >
              <input
                id="elec-blower-power"
                name="blowerPower"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 500"
                aria-describedby="elec-blower-power-error"
                data-field="blowerPower"
                class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <p
                id="elec-blower-power-error"
                class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
                data-error-for="blowerPower"
                role="alert"
              ></p>
            </div>
            <div>
              <label for="elec-blower-runtime" class="block text-sm font-medium text-ink"
                >Blower runtime (hours/day)</label
              >
              <input
                id="elec-blower-runtime"
                name="blowerRuntime"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 0.5"
                aria-describedby="elec-blower-runtime-error"
                data-field="blowerRuntime"
                class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <p
                id="elec-blower-runtime-error"
                class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
                data-error-for="blowerRuntime"
                role="alert"
              ></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="space-y-4">
          <legend class="font-display text-lg font-semibold text-ink"
            >Other spa equipment (optional)</legend
          >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="elec-other-power" class="block text-sm font-medium text-ink"
                >Other power</label
              >
              <input
                id="elec-other-power"
                name="otherPower"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 100"
                aria-describedby="elec-other-power-error"
                data-field="otherPower"
                class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <p
                id="elec-other-power-error"
                class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
                data-error-for="otherPower"
                role="alert"
              ></p>
            </div>
            <div>
              <label for="elec-other-runtime" class="block text-sm font-medium text-ink"
                >Other runtime (hours/day)</label
              >
              <input
                id="elec-other-runtime"
                name="otherRuntime"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="e.g. 2"
                aria-describedby="elec-other-runtime-error"
                data-field="otherRuntime"
                class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              />
              <p
                id="elec-other-runtime-error"
                class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
                data-error-for="otherRuntime"
                role="alert"
              ></p>
            </div>
          </div>
        </fieldset>
      </div>

      <fieldset class="rounded-xl border border-border/80 bg-surface/60 p-4 sm:p-5">
        <legend class="px-1 font-display text-base font-semibold text-ink">
          Optional seasonal comparison
        </legend>
        <p class="mt-1 text-sm text-ink-subtle">
          Compare your current heater runtime with a second user-entered scenario (for example
          warmer- or colder-weather heating). Other inputs stay constant. This does not predict
          actual seasonal bills.
        </p>
        <div class="mt-3 sm:max-w-xs">
          <label for="elec-compare-runtime" class="block text-sm font-medium text-ink"
            >Comparison heater runtime (hours/day)</label
          >
          <input
            id="elec-compare-runtime"
            name="compareHeaterRuntime"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="Leave blank to skip"
            aria-describedby="elec-compare-runtime-hint elec-compare-runtime-error"
            data-field="compareHeaterRuntime"
            class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
          <p id="elec-compare-runtime-hint" class="mt-1.5 text-sm text-ink-subtle">
            Optional. Do not reduce required filtration or disable freeze protection to chase a
            lower estimate.
          </p>
          <p
            id="elec-compare-runtime-error"
            class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
            data-error-for="compareHeaterRuntime"
            role="alert"
          ></p>
        </div>
      </fieldset>
    </div>

    <!-- Method B: Measured -->
    <div data-method-panel="measured" class="hidden space-y-6">
      <div
        class="rounded-xl border border-warning-border bg-warning-bg p-4 text-sm leading-relaxed text-warning-ink"
        role="note"
      >
        <strong class="font-semibold">Safety:</strong>
        Enter spa-attributable readings from manufacturer energy reporting or professionally
        installed monitoring. Do not open an electrical panel, install monitoring equipment, use
        clamp meters on live wiring, connect unsuitable plug-in meters, or bypass GFCI protection.
      </div>
      <div>
        <label for="elec-measured-kwh" class="block text-sm font-medium text-ink"
          >Measured spa electricity use (kWh)</label
        >
        <input
          id="elec-measured-kwh"
          name="measuredKwh"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="e.g. 120"
          aria-describedby="elec-measured-kwh-hint elec-measured-kwh-error"
          data-field="measuredKwh"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        />
        <p id="elec-measured-kwh-hint" class="mt-1.5 text-sm text-ink-subtle">
          Must be attributable to the spa, not total household consumption
        </p>
        <p
          id="elec-measured-kwh-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="measuredKwh"
          role="alert"
        ></p>
      </div>
      <div>
        <label for="elec-measurement-days" class="block text-sm font-medium text-ink"
          >Measurement period (days)</label
        >
        <input
          id="elec-measurement-days"
          name="measurementDays"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          placeholder="e.g. 30"
          aria-describedby="elec-measurement-days-hint elec-measurement-days-error"
          data-field="measurementDays"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        />
        <p id="elec-measurement-days-hint" class="mt-1.5 text-sm text-ink-subtle">
          Whole number of days covered by the measured kWh. Short periods assume similar future
          usage and conditions when extrapolated.
        </p>
        <p
          id="elec-measurement-days-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="measurementDays"
          role="alert"
        ></p>
      </div>
    </div>

    <!-- Method C: Standby -->
    <div data-method-panel="standby" class="hidden space-y-6">
      <p class="text-sm leading-relaxed text-ink-muted">
        Use published model-specific normalized standby power (watts) or annual standby electricity
        (kWh) from a manufacturer energy label or appropriate official appliance-efficiency listing.
        Not every spa has an energy label. Results are standby-only estimates—not total operating
        costs—and are not combined with equipment wattage inputs.
      </p>
      <fieldset>
        <legend class="font-display text-lg font-semibold text-ink">Standby input</legend>
        <div class="mt-3 grid grid-cols-1 gap-2" role="radiogroup" aria-label="Standby input type">
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
          >
            <input
              type="radio"
              name="standbyInputMode"
              value="watts"
              checked
              class="h-4 w-4 accent-brand"
              data-standby-mode
            />
            <span class="text-base font-medium text-ink">Normalized standby power (watts)</span>
          </label>
          <label
            class="flex min-h-12 cursor-pointer items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3 has-[:checked]:border-brand has-[:checked]:bg-brand-soft"
          >
            <input
              type="radio"
              name="standbyInputMode"
              value="annualKwh"
              class="h-4 w-4 accent-brand"
              data-standby-mode
            />
            <span class="text-base font-medium text-ink"
              >Annual standby electricity (kWh/year)</span
            >
          </label>
        </div>
      </fieldset>

      <div data-standby-watts-wrap>
        <label for="elec-standby-watts" class="block text-sm font-medium text-ink"
          >Published standby power (W)</label
        >
        <input
          id="elec-standby-watts"
          name="standbyWatts"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="e.g. 150"
          aria-describedby="elec-standby-watts-hint elec-standby-watts-error"
          data-field="standbyWatts"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        />
        <p id="elec-standby-watts-hint" class="mt-1.5 text-sm text-ink-subtle">
          Daily standby kWh = watts ÷ 1,000 × 24. Use tested/published standby power—not a maximum
          permitted limit.
        </p>
        <p
          id="elec-standby-watts-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="standbyWatts"
          role="alert"
        ></p>
      </div>

      <div class="hidden" data-standby-annual-wrap>
        <label for="elec-annual-standby" class="block text-sm font-medium text-ink"
          >Published annual standby electricity (kWh)</label
        >
        <input
          id="elec-annual-standby"
          name="annualStandbyKwh"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="e.g. 1200"
          aria-describedby="elec-annual-standby-hint elec-annual-standby-error"
          data-field="annualStandbyKwh"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand sm:max-w-xs"
        />
        <p id="elec-annual-standby-hint" class="mt-1.5 text-sm text-ink-subtle">
          Daily standby kWh = annual kWh ÷ 365
        </p>
        <p
          id="elec-annual-standby-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="annualStandbyKwh"
          role="alert"
        ></p>
      </div>
    </div>

    <!-- Shared rate / billing -->
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="elec-rate" class="block text-sm font-medium text-ink">Electricity rate</label>
        <div class="mt-2 grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,11rem)]">
          <input
            id="elec-rate"
            name="rate"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            placeholder="e.g. 0.15"
            aria-describedby="elec-rate-hint elec-rate-error"
            data-field="rate"
            class="min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          />
          <select
            id="elec-rate-unit"
            name="rateUnit"
            data-rate-unit
            aria-label="Electricity rate unit"
            class="min-h-12 w-full rounded-xl border border-border bg-surface px-3 text-base text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <option value="per_kwh" selected>$/kWh</option>
            <option value="cents_per_kwh">¢/kWh</option>
          </select>
        </div>
        <p id="elec-rate-hint" class="mt-1.5 text-sm text-ink-subtle">
          Use the electricity rate shown on your utility bill. USD only.
        </p>
        <p
          id="elec-rate-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="rate"
          role="alert"
        ></p>
      </div>
      <div>
        <label for="elec-days" class="block text-sm font-medium text-ink"
          >Days in billing period</label
        >
        <input
          id="elec-days"
          name="days"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          value="30"
          aria-describedby="elec-days-hint elec-days-error"
          data-field="days"
          class="mt-2 min-h-12 w-full rounded-xl border border-border bg-surface px-4 text-base text-ink placeholder:text-ink-subtle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        />
        <p id="elec-days-hint" class="mt-1.5 text-sm text-ink-subtle">
          Whole number from 1 through 366
        </p>
        <p
          id="elec-days-error"
          class="mt-1.5 hidden text-sm font-medium text-[#9b3b2e]"
          data-error-for="days"
          role="alert"
        ></p>
      </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <button
        type="submit"
        class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand px-5 text-base font-medium text-white transition-colors hover:bg-brand-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Estimate electricity cost
      </button>
      <button
        type="button"
        data-reset
        class="inline-flex min-h-12 items-center justify-center rounded-xl border border-border bg-surface px-5 text-base font-medium text-ink transition-colors hover:border-brand/40 hover:bg-brand-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        Reset
      </button>
    </div>
  </form>

  <div
    class="mt-6 hidden rounded-2xl border border-brand/25 bg-brand-soft p-5 sm:p-6"
    data-result
    aria-live="polite"
    aria-atomic="true"
  ></div>
</div>

<script>
  import {
    calculateElectricityCost,
    calculateMeasuredElectricityCost,
    calculateStandbyElectricityCost,
    compareSeasonalHeaterRuntime,
    ESTIMATION_METHOD_LABELS,
    formatCurrencyUsd,
    formatKwh,
    POWER_UNIT_LABELS,
    RATE_UNIT_LABELS,
    type ElectricityFieldKey,
    type ElectricityMode,
    type ElectricityResult,
    type EstimationMethod,
    type PowerUnit,
    type RateUnit,
    type SeasonalComparisonResult,
    type StandbyInputMode,
  } from '../utils/hot-tub-electricity-cost';

  function initCalculator(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-electricity-form]');
    const resultEl = root.querySelector<HTMLElement>('[data-result]');
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]');
    const powerUnit = root.querySelector<HTMLSelectElement>('[data-power-unit]');
    const rateUnit = root.querySelector<HTMLSelectElement>('[data-rate-unit]');
    const detailedFields = root.querySelector<HTMLElement>('[data-detailed-fields]');
    const standbyWattsWrap = root.querySelector<HTMLElement>('[data-standby-watts-wrap]');
    const standbyAnnualWrap = root.querySelector<HTMLElement>('[data-standby-annual-wrap]');

    if (!form || !resultEl || !resetBtn || !powerUnit || !rateUnit || !detailedFields) return;

    const fieldOrder: ElectricityFieldKey[] = [
      'heaterPower',
      'heaterRuntime',
      'circulationPumpPower',
      'circulationPumpRuntime',
      'jetPumpPower',
      'jetPumpRuntime',
      'blowerPower',
      'blowerRuntime',
      'otherPower',
      'otherRuntime',
      'rate',
      'days',
      'measuredKwh',
      'measurementDays',
      'standbyWatts',
      'annualStandbyKwh',
      'compareHeaterRuntime',
    ];

    function currentEstimationMethod(): EstimationMethod {
      const checked = form!.querySelector<HTMLInputElement>(
        'input[name="estimationMethod"]:checked',
      );
      if (checked?.value === 'measured') return 'measured';
      if (checked?.value === 'standby') return 'standby';
      return 'equipment';
    }

    function currentMode(): ElectricityMode {
      const checked = form!.querySelector<HTMLInputElement>('input[name="mode"]:checked');
      return checked?.value === 'detailed' ? 'detailed' : 'simple';
    }

    function currentStandbyMode(): StandbyInputMode {
      const checked = form!.querySelector<HTMLInputElement>(
        'input[name="standbyInputMode"]:checked',
      );
      return checked?.value === 'annualKwh' ? 'annualKwh' : 'watts';
    }

    function setVisible(el: HTMLElement | null, visible: boolean) {
      if (!el) return;
      el.hidden = !visible;
      el.classList.toggle('hidden', !visible);
    }

    function syncMethodPanels() {
      const method = currentEstimationMethod();
      for (const panel of root.querySelectorAll<HTMLElement>('[data-method-panel]')) {
        setVisible(panel, panel.getAttribute('data-method-panel') === method);
      }
      if (method === 'equipment') syncMode();
      if (method === 'standby') syncStandbyMode();
    }

    function syncMode() {
      const isDetailed = currentMode() === 'detailed';
      setVisible(detailedFields, isDetailed);
      for (const input of detailedFields!.querySelectorAll('input')) {
        input.disabled = !isDetailed;
      }
    }

    function syncStandbyMode() {
      const mode = currentStandbyMode();
      setVisible(standbyWattsWrap, mode === 'watts');
      setVisible(standbyAnnualWrap, mode === 'annualKwh');
    }

    function fieldValue(field: ElectricityFieldKey): string {
      return form!.querySelector<HTMLInputElement>(`[data-field="${field}"]`)?.value ?? '';
    }

    function clearErrors() {
      for (const field of fieldOrder) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
        const error = form!.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (input) {
          input.removeAttribute('aria-invalid');
          input.classList.remove('border-[#c45c4a]');
        }
        if (error) {
          error.textContent = '';
          error.classList.add('hidden');
        }
      }
    }

    function showErrors(errors: { field: ElectricityFieldKey; message: string }[]) {
      clearErrors();
      for (const error of errors) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${error.field}"]`);
        const errorEl = form!.querySelector<HTMLElement>(`[data-error-for="${error.field}"]`);
        if (input && !input.disabled) {
          input.setAttribute('aria-invalid', 'true');
          input.classList.add('border-[#c45c4a]');
        }
        if (errorEl) {
          errorEl.textContent = error.message;
          errorEl.classList.remove('hidden');
        }
      }
      const first = errors[0];
      if (!first) return;
      form!.querySelector<HTMLInputElement>(`[data-field="${first.field}"]`)?.focus();
    }

    function clearResult() {
      resultEl!.hidden = true;
      resultEl!.classList.add('hidden');
      resultEl!.innerHTML = '';
    }

    function escapeHtml(value: string): string {
      return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderCostBlock(data: ElectricityResult, heading: string) {
      const resultKind =
        data.estimationMethod === 'standby'
          ? 'Standby-energy estimate'
          : data.estimationMethod === 'measured'
            ? 'Extrapolated from measured observations'
            : 'Equipment wattage estimate';

      let breakdown = '';
      if (data.estimationMethod === 'equipment' && data.devices.length > 0) {
        const powerLabel = POWER_UNIT_LABELS[data.powerUnit];
        breakdown = `
          <div class="mt-5">
            <h3 class="font-display text-base font-semibold text-ink">Device breakdown</h3>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink-muted">
              ${data.devices
                .map(
                  (device) => `
                <li>
                  <span class="font-medium text-ink">${escapeHtml(device.label)}:</span>
                  ${escapeHtml(device.powerEntered)} ${escapeHtml(powerLabel.toLowerCase())} ×
                  ${escapeHtml(device.runtimeEntered)} h/day =
                  ${escapeHtml(formatKwh(device.displayDailyKwh))} kWh/day
                </li>`,
                )
                .join('')}
            </ul>
          </div>`;
      }

      const assumptions = data.assumptions
        .map((a) => `<li>${escapeHtml(a)}</li>`)
        .join('');

      return `
        <h2 class="font-display text-xl font-semibold text-ink">${escapeHtml(heading)}</h2>
        <p class="mt-2 text-sm font-medium text-ink-muted">${escapeHtml(resultKind)}</p>
        <p class="mt-1 text-sm text-ink-muted">
          Method: ${escapeHtml(ESTIMATION_METHOD_LABELS[data.estimationMethod])}
        </p>
        <p class="mt-4 text-2xl font-semibold text-ink sm:text-3xl">
          ${escapeHtml(formatKwh(data.displayDailyKwh))} kWh per day
        </p>
        <p class="mt-1 text-xl font-semibold text-ink sm:text-2xl">
          ${escapeHtml(formatCurrencyUsd(data.displayDailyCost))} per day
        </p>
        <p class="mt-4 text-2xl font-semibold text-ink sm:text-3xl">
          ${escapeHtml(formatKwh(data.displayPeriodKwh))} kWh over ${escapeHtml(String(data.days))} days
        </p>
        <p class="mt-1 text-xl font-semibold text-ink sm:text-2xl">
          ${escapeHtml(formatCurrencyUsd(data.displayPeriodCost))} over ${escapeHtml(String(data.days))} days
        </p>
        <p class="mt-4 text-base text-ink-muted">
          <span class="font-medium text-ink">Annualized extrapolation:</span>
          ${escapeHtml(formatCurrencyUsd(data.displayAnnualCost))} per year
          (daily cost × 365). This is not a utility forecast.
        </p>
        ${breakdown}
        <div class="mt-5 rounded-xl border border-warning-border bg-warning-bg p-4 text-sm leading-relaxed text-warning-ink" role="note">
          <strong class="font-semibold">Estimate warning:</strong>
          Actual electricity use and bills can vary substantially. This tool does not include demand
          charges, tiered rates, taxes, fees, or time-of-use pricing unless you already folded those
          into the rate you entered.
        </div>
        <dl class="mt-5 space-y-2 text-sm text-ink-muted">
          <div>
            <dt class="inline font-medium text-ink">Electricity rate:</dt>
            <dd class="inline">
              ${escapeHtml(data.rateEntered)} (${escapeHtml(RATE_UNIT_LABELS[data.rateUnit])})
            </dd>
          </div>
          <div>
            <dt class="inline font-medium text-ink">Billing period:</dt>
            <dd class="inline">${escapeHtml(data.daysEntered)} days</dd>
          </div>
          <div>
            <dt class="font-medium text-ink">Assumptions &amp; limitations</dt>
            <dd><ul class="mt-1 list-disc space-y-1 pl-5">${assumptions}</ul></dd>
          </div>
        </dl>
        <p class="mt-5 text-sm text-ink-muted">
          For one-time heating from cold, use the
          <a href="/calculators/hot-tub-heat-up-time-calculator" class="font-medium text-brand-dark underline-offset-2 hover:underline">Heat-up time calculator</a>.
        </p>
      `;
    }

    function renderSeasonal(comparison: SeasonalComparisonResult) {
      const sign = (n: number) => (n > 0 ? '+' : '');
      return `
        <div class="mt-6 border-t border-brand/20 pt-5">
          <h3 class="font-display text-lg font-semibold text-ink">Seasonal comparison</h3>
          <p class="mt-2 text-sm text-ink-muted">
            Comparison heater runtime: ${escapeHtml(String(comparison.compareHeaterRuntime))} h/day
            (other inputs held constant).
          </p>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted">
            <li>
              Daily electricity difference:
              ${escapeHtml(sign(comparison.displayDailyKwhDifference))}${escapeHtml(
                formatKwh(comparison.displayDailyKwhDifference),
              )} kWh/day
            </li>
            <li>
              Billing-period cost difference:
              ${escapeHtml(sign(comparison.displayPeriodCostDifference))}${escapeHtml(
                formatCurrencyUsd(comparison.displayPeriodCostDifference),
              )}
            </li>
          </ul>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ink-muted">
            ${comparison.assumptions.map((a) => `<li>${escapeHtml(a)}</li>`).join('')}
          </ul>
        </div>
      `;
    }

    function renderResult(
      data: ElectricityResult,
      seasonal: SeasonalComparisonResult | null = null,
    ) {
      resultEl!.innerHTML =
        renderCostBlock(data, 'Electricity cost estimate') +
        (seasonal ? renderSeasonal(seasonal) : '');
      resultEl!.hidden = false;
      resultEl!.classList.remove('hidden');
    }

    function equipmentInputs() {
      return {
        mode: currentMode(),
        powerUnit: powerUnit!.value as PowerUnit,
        rateUnit: rateUnit!.value as RateUnit,
        heater: {
          power: fieldValue('heaterPower'),
          runtimeHours: fieldValue('heaterRuntime'),
        },
        circulationPump: {
          power: fieldValue('circulationPumpPower'),
          runtimeHours: fieldValue('circulationPumpRuntime'),
        },
        jetPump: {
          power: fieldValue('jetPumpPower'),
          runtimeHours: fieldValue('jetPumpRuntime'),
        },
        blower: {
          power: fieldValue('blowerPower'),
          runtimeHours: fieldValue('blowerRuntime'),
        },
        other: {
          power: fieldValue('otherPower'),
          runtimeHours: fieldValue('otherRuntime'),
        },
        rate: fieldValue('rate'),
        days: fieldValue('days'),
      };
    }

    form.querySelectorAll('[data-estimation-method]').forEach((el) => {
      el.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncMethodPanels();
      });
    });
    form.querySelectorAll('[data-mode-input]').forEach((el) => {
      el.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncMode();
      });
    });
    form.querySelectorAll('[data-standby-mode]').forEach((el) => {
      el.addEventListener('change', () => {
        clearErrors();
        clearResult();
        syncStandbyMode();
      });
    });

    // Preserve power values when switching W/kW
    let lastPowerUnit: PowerUnit = (powerUnit.value as PowerUnit) || 'W';
    powerUnit.addEventListener('change', () => {
      const next = powerUnit.value as PowerUnit;
      const fields: ElectricityFieldKey[] = [
        'heaterPower',
        'circulationPumpPower',
        'jetPumpPower',
        'blowerPower',
        'otherPower',
      ];
      for (const field of fields) {
        const input = form!.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
        if (!input?.value.trim()) continue;
        const n = Number(input.value.trim().replace(/,/g, ''));
        if (!Number.isFinite(n)) continue;
        const kw = lastPowerUnit === 'kW' ? n : n / 1000;
        const converted = next === 'kW' ? kw : kw * 1000;
        input.value = String(Math.round(converted * 1e6) / 1e6);
      }
      lastPowerUnit = next;
      clearResult();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const method = currentEstimationMethod();

      if (method === 'equipment') {
        const inputs = equipmentInputs();
        const compareRaw = fieldValue('compareHeaterRuntime').trim();
        if (compareRaw) {
          const seasonal = compareSeasonalHeaterRuntime(inputs, compareRaw);
          if (!seasonal.ok) {
            clearResult();
            showErrors(seasonal.errors);
            return;
          }
          clearErrors();
          renderResult(seasonal.result.baseline, seasonal.result);
          return;
        }
        const outcome = calculateElectricityCost(inputs);
        if (!outcome.ok) {
          clearResult();
          showErrors(outcome.errors);
          return;
        }
        clearErrors();
        renderResult(outcome.result);
        return;
      }

      if (method === 'measured') {
        const outcome = calculateMeasuredElectricityCost({
          measuredKwh: fieldValue('measuredKwh'),
          measurementDays: fieldValue('measurementDays'),
          rate: fieldValue('rate'),
          rateUnit: rateUnit.value as RateUnit,
          days: fieldValue('days'),
        });
        if (!outcome.ok) {
          clearResult();
          showErrors(outcome.errors);
          return;
        }
        clearErrors();
        renderResult(outcome.result);
        return;
      }

      const outcome = calculateStandbyElectricityCost({
        inputMode: currentStandbyMode(),
        standbyWatts: fieldValue('standbyWatts'),
        annualStandbyKwh: fieldValue('annualStandbyKwh'),
        rate: fieldValue('rate'),
        rateUnit: rateUnit.value as RateUnit,
        days: fieldValue('days'),
      });
      if (!outcome.ok) {
        clearResult();
        showErrors(outcome.errors);
        return;
      }
      clearErrors();
      renderResult(outcome.result);
    });

    resetBtn.addEventListener('click', () => {
      form.reset();
      lastPowerUnit = 'W';
      const equipment = form.querySelector<HTMLInputElement>(
        'input[name="estimationMethod"][value="equipment"]',
      );
      if (equipment) equipment.checked = true;
      const simple = form.querySelector<HTMLInputElement>('input[name="mode"][value="simple"]');
      if (simple) simple.checked = true;
      powerUnit.value = 'W';
      rateUnit.value = 'per_kwh';
      const days = form.querySelector<HTMLInputElement>('[data-field="days"]');
      if (days) days.value = '30';
      clearErrors();
      clearResult();
      syncMethodPanels();
      equipment?.focus();
    });

    syncMethodPanels();
  }

  document.querySelectorAll<HTMLElement>('[data-electricity-calculator]').forEach(initCalculator);
</script>
