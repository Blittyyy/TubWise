---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Contact TubWise"
  description="Contact TubWise about article corrections, website problems, privacy requests, feedback, or partnership inquiries."
  path="/contact"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
>
  <p>
    You can contact TubWise about corrections to an article, broken links or website
    problems, privacy requests, general feedback, or business or partnership inquiries.
  </p>

  <h2 id="email">Email</h2>
  <p>
    Email us at{' '}
    <a href="mailto:hello@gettubwise.com">hello@gettubwise.com</a>.
  </p>

  <h2 id="what-to-include">What to include</h2>
  <ul>
    <li>The page URL your note is about</li>
    <li>Spa brand and model, if relevant</li>
    <li>The exact error code or symptom, if you are reporting a content gap</li>
  </ul>

  <h2 id="what-we-do-not-provide">What we do not provide</h2>
  <p>
    TubWise does not provide emergency, medical, electrical, chemical, repair, or
    individualized professional support by email. If you have an urgent safety issue,
    contact the appropriate qualified professional rather than relying on TubWise.
  </p>
</PageLayout>
