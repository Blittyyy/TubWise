---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import HotTubElectricityCostCalculator from '../../components/HotTubElectricityCostCalculator.astro';
import { breadcrumbSchema, webApplicationSchema } from '../../utils/schema';
import {
  exampleDailyKwh,
  examplePeriodCost,
} from '../../utils/hot-tub-electricity-cost';

const path = '/calculators/hot-tub-electricity-cost-calculator';
const title = 'Hot Tub Electricity Cost Calculator: Monthly & Yearly Cost';
const description =
  "Estimate your hot tub's monthly and yearly electricity costs using equipment wattage, measured energy use or manufacturer standby energy ratings.";

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Calculators', href: '/calculators' },
  { label: 'Hot Tub Electricity Cost Calculator' },
];

const exampleAssumptions = {
  heaterKw: 4,
  pumpKw: 0.25,
  pumpHours: 8,
  rate: 0.15,
  days: 30,
};

const exampleRows = [1, 2, 3, 4, 6].map((heaterHours) => {
  const dailyKwh = exampleDailyKwh(
    exampleAssumptions.heaterKw,
    heaterHours,
    exampleAssumptions.pumpKw,
    exampleAssumptions.pumpHours,
  );
  const periodCost = examplePeriodCost(
    dailyKwh,
    exampleAssumptions.rate,
    exampleAssumptions.days,
  );
  return { heaterHours, dailyKwh, periodCost };
});

const relatedGuides = [
  {
    title: 'How to Choose a Hot Tub Cover',
    description:
      'Match replacement cover fit and construction details without treating any cover as a guaranteed energy saver.',
    href: '/buying-guides/how-to-choose-a-hot-tub-cover',
    category: 'Buying Guides',
  },
  {
    title: 'When Should You Replace a Hot Tub Cover?',
    description:
      'Manufacturer-backed replacement cues such as damage, sagging, and waterlogging.',
    href: '/maintenance/when-should-you-replace-a-hot-tub-cover',
    category: 'Maintenance',
  },
  {
    title: 'Why Is My Hot Tub Cover So Heavy?',
    description:
      'Separate normal cover weight, exterior water, and possible foam-core moisture.',
    href: '/maintenance/why-is-my-hot-tub-cover-so-heavy',
    category: 'Maintenance',
  },
  {
    title: 'Hot Tub Maintenance Checklist: Weekly, Monthly, and Seasonal Tasks',
    description: 'A manufacturer-backed planning checklist for ongoing spa care.',
    href: '/maintenance/hot-tub-maintenance-checklist-weekly-monthly-and-seasonal-tasks',
    category: 'Maintenance',
  },
  {
    title: 'Hot Tub Volume Calculator',
    description: 'Estimate spa capacity in gallons and liters from interior dimensions.',
    href: '/calculators/hot-tub-volume-calculator',
    category: 'Calculators',
  },
  {
    title: 'Hot Tub Fill Time Calculator',
    description: 'Estimate remaining water and how long a fill may take.',
    href: '/calculators/hot-tub-fill-time-calculator',
    category: 'Calculators',
  },
  {
    title: 'Hot Tub Heat-Up Time Calculator',
    description: 'Estimate one heat-up from capacity and heater power or a measured rate.',
    href: '/calculators/hot-tub-heat-up-time-calculator',
    category: 'Calculators',
  },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  webApplicationSchema({
    name: 'Hot Tub Electricity Cost Calculator',
    description,
    path,
  }),
];
---

<BaseLayout title={title} description={description} path={path} schema={schemas}>
  <div class="container-site section-space">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mx-auto mb-8 w-full max-w-3xl">
      <h1 class="text-3xl font-semibold sm:text-4xl">Hot Tub Electricity Cost Calculator</h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-muted">
        Estimate monthly and yearly electricity costs from equipment wattage, measured spa energy
        use, or manufacturer standby energy ratings.
      </p>
    </header>

    <div class="mx-auto w-full max-w-3xl">
      <HotTubElectricityCostCalculator />
    </div>

    <div class="prose-site mx-auto mt-12 max-w-3xl">
      <h2 id="how-it-works">How the estimate works</h2>
      <p>
        Choose one estimation method at a time. Equipment mode multiplies each device’s power in
        kilowatts by runtime hours per day, totals the devices you entered, multiplies by your
        electricity rate, then scales by billing-period days. An optional annualized figure
        multiplies daily cost by 365 and is labeled as an extrapolation, not a utility forecast.
      </p>
      <p>
        Heater runtime means the estimated time the heater is actively drawing its rated power—not
        simply the time the spa remains turned on. Rated wattage is not continuous use. TubWise does
        not estimate heater wattage from breaker rating or supply voltage.
      </p>
      <p>
        Measured mode divides spa-attributable kWh by measurement days, then scales cost by your
        rate and billing period. Energy-label mode converts published standby watts (÷ 1,000 × 24)
        or annual standby kWh (÷ 365) into a daily standby estimate only—it does not add equipment
        loads on top, and it is not a total operating-cost claim.
      </p>

      <h2 id="example-table">Illustrative equipment example</h2>
      <p>
        The table below is explicitly illustrative. Assumptions: heater 4&nbsp;kW, circulation pump
        250&nbsp;W for 8 hours/day, electricity rate $0.15/kWh, billing period 30 days. These are
        not typical hot tub costs.
      </p>
      <div class="not-prose overflow-x-auto">
        <table class="w-full min-w-[28rem] border-collapse text-left text-sm text-ink">
          <thead>
            <tr class="border-b border-border">
              <th class="py-2 pr-3 font-semibold">Heater runtime</th>
              <th class="py-2 pr-3 font-semibold">Daily electricity</th>
              <th class="py-2 font-semibold">30-day cost</th>
            </tr>
          </thead>
          <tbody class="text-ink-muted">
            {
              exampleRows.map((row) => (
                <tr class="border-b border-border/70 last:border-0">
                  <td class="py-2.5 pr-3 font-medium text-ink">
                    {row.heaterHours === 1 ? '1 hour/day' : `${row.heaterHours} hours/day`}
                  </td>
                  <td class="py-2.5 pr-3">{row.dailyKwh} kWh</td>
                  <td class="py-2.5">${row.periodCost}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 id="cost-types">Types of electricity estimates</h2>
      <ul>
        <li>
          <strong>One-time heating from cold</strong> — a single heat-up event. Use the
          <a href="/calculators/hot-tub-heat-up-time-calculator">Heat-up time calculator</a> for that
          estimate; it is not the same as ongoing operating cost.
        </li>
        <li>
          <strong>Ongoing operating costs</strong> — equipment wattage × daily runtime under your
          assumptions (Simple or Detailed mode).
        </li>
        <li>
          <strong>Standardized standby energy</strong> — published standby power or annual standby
          kWh under test conditions that differ from real-world use. Standby figures may already
          include heating and circulation needed to maintain temperature. Do not confuse maximum
          permitted standby limits with actual tested values, and do not assume every spa has a
          label.
        </li>
        <li>
          <strong>Actual measured consumption</strong> — spa-attributable kWh from suitable
          manufacturer reporting or professionally installed monitoring, extrapolated only if future
          usage and conditions are similar.
        </li>
      </ul>
      <p>
        Prefer primary regulatory and manufacturer documentation when looking up portable electric
        spa energy labels or appliance-efficiency listings for your model.
      </p>

      <h2 id="where-to-find-wattage">Where to find equipment wattage</h2>
      <p>Obtain equipment ratings only from:</p>
      <ul>
        <li>The owner’s manual</li>
        <li>Manufacturer specifications</li>
        <li>Safely visible external nameplate or documentation</li>
        <li>Installer documentation</li>
      </ul>
      <p>
        Do not open electrical enclosures or equipment compartments to read values. If ratings are
        unclear, ask your dealer or a qualified technician rather than guessing from unsafe access.
      </p>

      <h2 id="why-costs-vary">Why actual costs vary</h2>
      <p>
        Outdoor temperature, desired water temperature, cover condition, insulation, wind exposure,
        heater cycling, filtration schedules, jet use, equipment efficiency, standby behavior, and
        utility rate structure can all change real electricity use. TubWise does not assign
        unsupported percentage savings to any one factor. Optional seasonal comparison in equipment
        mode uses a second user-entered heater runtime only—it does not auto-assign values from
        weather or cover quality, and it does not predict actual seasonal bills.
      </p>

      <h2 id="improve-accuracy">Ways to improve estimate accuracy</h2>
      <ul>
        <li>Use the electricity rate printed on your utility bill</li>
        <li>Use model-specific wattage or standby ratings from manufacturer documentation</li>
        <li>Track actual heater and pump runtime when your controls make that practical</li>
        <li>Compare the estimate with spa-attributable utility usage over time</li>
        <li>Update inputs for seasonal weather and schedule changes</li>
      </ul>
      <p>
        Do not open an electrical panel, install electrical monitoring equipment yourself, use clamp
        meters on live wiring, connect unsuitable plug-in energy meters, or bypass GFCI protection.
      </p>

      <h2 id="disclaimer">Disclaimer</h2>
      <p>
        This calculator is a planning estimate only. It is not a substitute for your spa
        manufacturer’s specifications, your utility bill, or professional advice. See the
        <a href="/disclaimer">Disclaimer</a> and <a href="/terms">Terms of Use</a> for more.
      </p>
    </div>

    <section class="mx-auto mt-12 w-full max-w-5xl" aria-labelledby="related-guides-heading">
      <h2 id="related-guides-heading" class="font-display text-2xl font-semibold text-ink">
        Relevant TubWise guides
      </h2>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-ink-muted">
        Cover condition and maintenance habits can influence heat loss, but replacing a cover does
        not guarantee lower electricity use. Use these guides alongside your estimate.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          relatedGuides.map((guide) => (
            <ArticleCard
              title={guide.title}
              description={guide.description}
              href={guide.href}
              category={guide.category}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
